<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.ARPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#000000">

    <Grid>
        <WebView x:Name="ArWebView"
                 StyleId="MeasureARWebView"
                 BackgroundColor="Transparent"
                 HorizontalOptions="Fill"
                 VerticalOptions="Fill"
                 Navigating="OnArWebViewNavigating" />

        <Button Text="Cerrar"
                Clicked="OnCloseClicked"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Margin="20,50,0,0"
                BackgroundColor="#CC001D39"
                TextColor="#FFFFFF"
                CornerRadius="14"
                FontAttributes="Bold"
                HeightRequest="44"
                Padding="18,0">
            <Button.Shadow>
                <Shadow Brush="#000000" Offset="0,4" Radius="10" Opacity="0.3" />
            </Button.Shadow>
        </Button>
    </Grid>
</ContentPage>
