<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.AdminUsersPage"
             Title="Gestión de Usuarios"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}">

    <Grid RowDefinitions="Auto,*">
        <Grid ColumnDefinitions="Auto,*,Auto" Padding="20,15" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">
            <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
            <Image Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseClicked"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="Usuarios" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>

        <RefreshView x:Name="UsersRefresh" Grid.Row="1" Refreshing="OnRefresh" RefreshColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}">
            <ScrollView>
                <VerticalStackLayout Padding="20" Spacing="15">
                    
                    <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HorizontalOptions="Center" Margin="0,20"/>

                    <CollectionView x:Name="UsersCollectionView">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" Margin="0,0,0,12">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                    <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                                    
                                    <Grid ColumnDefinitions="*,Auto" Padding="15">
                                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Nombre}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="16" FontAttributes="Bold"/>
                                            <Label Text="{Binding Email}" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="13"/>
                                            <Border BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1E1E1E}" StrokeThickness="0" HorizontalOptions="Start" Padding="8,4" Margin="0,5,0,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                                <Label Text="{Binding Rol}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" FontSize="10" FontAttributes="Bold"/>
                                            </Border>
                                        </VerticalStackLayout>
                                        
                                        <Border Grid.Column="1" BackgroundColor="#FFF0F0" StrokeThickness="0" WidthRequest="36" HeightRequest="36" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                                            <Image Source="ic_trash.svg" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDeleteUserClicked" CommandParameter="{Binding .}"/>
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                                <Label Text="No hay usuarios" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
