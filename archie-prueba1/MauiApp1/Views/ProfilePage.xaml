<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.ProfilePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ===== HEADER: solo ☰ ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,40,20,10">

            <Grid Grid.Column="0"/>

            <Image Grid.Column="1" Source="ic_menu.svg" WidthRequest="26" HeightRequest="26"
                   VerticalOptions="Center">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenMenuSheetClicked"/>
                </Image.GestureRecognizers>
            </Image>
        </Grid>

        <!-- ===== CONTENIDO SCROLL ===== -->
        <ScrollView Grid.Row="1" x:Name="MainScroll" Opacity="0" TranslationY="30">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,120">

                <!-- Avatar + Nombre + Métricas -->
                <Grid ColumnDefinitions="Auto,*" Padding="20,10,20,15" ColumnSpacing="20">

                    <Grid Grid.Column="0" WidthRequest="90" HeightRequest="90">
                        <Border BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                StrokeThickness="0"
                                WidthRequest="90" HeightRequest="90">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="45"/>
                            </Border.StrokeShape>
                            <Grid>
                                <Label x:Name="AvatarInitialsLabel" Text="U"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                       FontSize="34" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Image x:Name="ProfileImage" Aspect="AspectFill" IsVisible="False"/>
                            </Grid>
                        </Border>

                        <Border BackgroundColor="#007AFF"
                                StrokeThickness="0"
                                WidthRequest="30" HeightRequest="30"
                                HorizontalOptions="End" VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="15"/>
                            </Border.StrokeShape>
                            <Image Source="ic_camera_white.svg" WidthRequest="14" HeightRequest="14"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnUploadProfilePictureClicked"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                        <Label x:Name="NombreUsuarioLabel" Text="Usuario"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                               LineBreakMode="TailTruncation"/>

                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="1" HorizontalOptions="Center">
                                <Label x:Name="LblStat1Value" Text="0"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="LblStat1Title" Text="Proyectos"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="1" HorizontalOptions="Center">
                                <Label x:Name="LblStat2Value" Text="0"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="LblStat2Title" Text="Salas"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="1" HorizontalOptions="Center">
                                <Label x:Name="LblStat3Value" Text="0"
                                       FontSize="17" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       HorizontalTextAlignment="Center"/>
                                <Label x:Name="LblStat3Title" Text="Mediciones"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>

                <!-- Botones -->
                <Grid ColumnDefinitions="*,*,Auto" Padding="20,0,20,15" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Editar"
                            BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            HeightRequest="36"
                            CornerRadius="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            Clicked="OnEditProfileClicked"/>

                    <Button Grid.Column="1"
                            Text="Compartir perfil"
                            BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                            TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                            HeightRequest="36"
                            CornerRadius="10"
                            FontSize="14"
                            FontAttributes="Bold"
                            Clicked="OnShareProfileClicked"/>

                    <Border Grid.Column="2"
                            BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                            StrokeThickness="0"
                            WidthRequest="36" HeightRequest="36">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Image Source="ic_user_add.svg" WidthRequest="18" HeightRequest="18"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnManageUsersClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- ===== TABS ===== -->
                <Grid ColumnDefinitions="*,*,*" Padding="20,0,20,0" Margin="0,10,0,0">
                    <Grid Grid.Column="0" HorizontalOptions="Center" Padding="0,10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Image x:Name="Tab1Icon" Source="ic_suggestions_active.svg" WidthRequest="26" HeightRequest="26"/>
                            <BoxView x:Name="Tab1Underline" HeightRequest="2" WidthRequest="40"
                                     BackgroundColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab1Tapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid Grid.Column="1" HorizontalOptions="Center" Padding="0,10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Image x:Name="Tab2Icon" Source="ic_measure_inactive.svg" WidthRequest="26" HeightRequest="26"/>
                            <BoxView x:Name="Tab2Underline" HeightRequest="2" WidthRequest="40"
                                     BackgroundColor="Transparent" IsVisible="False"/>
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab2Tapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>

                    <Grid Grid.Column="2" HorizontalOptions="Center" Padding="0,10">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Image x:Name="Tab3Icon" Source="ic_rooms_inactive.svg" WidthRequest="26" HeightRequest="26"/>
                            <BoxView x:Name="Tab3Underline" HeightRequest="2" WidthRequest="40"
                                     BackgroundColor="Transparent" IsVisible="False"/>
                        </VerticalStackLayout>
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTab3Tapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>

                <BoxView HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"/>

                <!-- ===== TAB 1: Sugerencias ===== -->
                <CollectionView x:Name="SuggestionsListCollectionView"
                                SelectionMode="None"
                                Margin="0,10,0,0"
                                IsVisible="True">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}"
                                    StrokeThickness="0"
                                    Margin="20,0,20,10"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding Titulo}"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                           LineBreakMode="TailTruncation"/>
                                    <Label Text="{Binding Descripcion}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                                           LineBreakMode="WordWrap"
                                           MaxLines="3"/>
                                    <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                                        <Border BackgroundColor="#E8F1FF"
                                                StrokeThickness="0" Padding="8,3">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Estado}"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="#007AFF"/>
                                        </Border>
                                        <Label Text="{Binding Fechacreacion, StringFormat='{0:dd/MM/yyyy}'}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center">
                            <Image Source="ic_suggestions_inactive.svg" WidthRequest="50" HeightRequest="50"
                                   HorizontalOptions="Center" Opacity="0.3"/>
                            <Label Text="Aún no hay sugerencias"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="LblEmptySugerencias"
                                   Text="Las sugerencias aparecerán aquí"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- ===== TAB 2: Mediciones ===== -->
                <CollectionView x:Name="MeasurementsListCollectionView"
                                SelectionMode="None"
                                Margin="0,10,0,0"
                                IsVisible="False">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}"
                                    StrokeThickness="0"
                                    Margin="20,0,20,10"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="{Binding FechaFormateada}"
                                               FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                        <Label Text="{Binding Etapa}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"/>
                                        <Label Text="{Binding Partida}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding Totalparcial, StringFormat='{0:F2}'}"
                                               FontSize="18" FontAttributes="Bold"
                                               TextColor="#007AFF"
                                               HorizontalTextAlignment="End"/>
                                        <Label Text="{Binding Unidad}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                               HorizontalTextAlignment="End"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center">
                            <Image Source="ic_measure_inactive.svg" WidthRequest="50" HeightRequest="50"
                                   HorizontalOptions="Center" Opacity="0.3"/>
                            <Label Text="Aún no hay mediciones"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Usa la cámara AR para tomar medidas"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- ===== TAB 3: Salas ===== -->
                <CollectionView x:Name="RoomsListCollectionView"
                                SelectionMode="None"
                                Margin="0,10,0,0"
                                IsVisible="False">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#1C1C1E}"
                                    StrokeThickness="0"
                                    Margin="20,0,20,10"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label Text="{Binding Nombre}"
                                               FontSize="15" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Ubicacion}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                               LineBreakMode="TailTruncation"/>
                                        <Border BackgroundColor="#E8F1FF"
                                                StrokeThickness="0"
                                                Padding="8,3"
                                                HorizontalOptions="Start"
                                                Margin="0,4,0,0">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>
                                            <Label Text="{Binding Codigosalaactiva}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="#007AFF"/>
                                        </Border>
                                    </VerticalStackLayout>

                                    <Border Grid.Column="1"
                                            BackgroundColor="#007AFF"
                                            StrokeThickness="0"
                                            WidthRequest="40" HeightRequest="40"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Image Source="ic_copy.svg" WidthRequest="16" HeightRequest="16"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnCopyRoomCodeTapped"
                                                                  CommandParameter="{Binding .}"/>
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center">
                            <Image Source="ic_rooms_inactive.svg" WidthRequest="50" HeightRequest="50"
                                   HorizontalOptions="Center" Opacity="0.3"/>
                            <Label Text="Aún no hay salas"
                                   FontSize="15" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Crea una sala desde el Dashboard con el botón +"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== TAB BAR ===== -->
        <controls:FloatingTabBar Grid.Row="2" SelectedIndex="4" />

        <!-- MODAL EDITAR PERFIL -->
        <BoxView x:Name="EditProfileBackdrop" Grid.RowSpan="3"
                 BackgroundColor="#80000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseEditProfileSheetTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="EditProfileSheetModal" Grid.RowSpan="3"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                StrokeThickness="0"
                VerticalOptions="End" HorizontalOptions="Fill"
                IsVisible="False" Opacity="0" TranslationY="800">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.15" Offset="0,-4" Radius="20"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0,0,0,20">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,16">
                    <Label Grid.Column="0" Text="Cancelar" FontSize="16" TextColor="#007AFF"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseEditProfileSheetTapped"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Column="1" Text="Editar Perfil"
                           FontSize="17" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>

                    <Label Grid.Column="2" Text="Guardar"
                           FontSize="16" FontAttributes="Bold"
                           TextColor="#007AFF"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubmitEditProfileTapped"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"/>

                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="20" Padding="20,20,20,10">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nombre" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EditNombreEntry" Placeholder="Nombre"
                                       PlaceholderColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       Margin="15,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Apellido" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EditApellidoEntry" Placeholder="Apellido"
                                       PlaceholderColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       Margin="15,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Teléfono" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EditTelefonoEntry" Placeholder="Teléfono"
                                       Keyboard="Telephone"
                                       PlaceholderColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       Margin="15,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Dirección" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EditDireccionEntry" Placeholder="Dirección"
                                       PlaceholderColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       Margin="15,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Número de documento" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EditDocumentoEntry" Placeholder="Documento"
                                       Keyboard="Numeric"
                                       PlaceholderColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       Margin="15,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="3"
                        Text="Guardar Cambios"
                        BackgroundColor="#007AFF"
                        TextColor="#FFFFFF"
                        HeightRequest="50" CornerRadius="14"
                        FontSize="17" FontAttributes="Bold"
                        Clicked="OnSubmitEditProfileClicked"
                        Margin="20,10,20,0"/>
            </Grid>
        </Border>

        <!-- MODAL MENÚ -->
        <BoxView x:Name="MenuBackdrop" Grid.RowSpan="3"
                 BackgroundColor="#80000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseMenuSheetTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="MenuSheetModal" Grid.RowSpan="3"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                StrokeThickness="0"
                VerticalOptions="End" HorizontalOptions="Fill"
                IsVisible="False" Opacity="0" TranslationY="600">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.15" Offset="0,-4" Radius="20"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0,0,0,20">

                <Grid Grid.Row="0" Padding="20,20,20,10">
                    <Label Text="Opciones"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                           HorizontalOptions="Center"/>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"/>

                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="MenuItemsStack" Spacing="0" Padding="0,10,0,10"/>
                </ScrollView>

                <Button Grid.Row="3"
                        Text="Cerrar"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                        TextColor="#007AFF"
                        HeightRequest="48" CornerRadius="14"
                        FontSize="16" FontAttributes="Bold"
                        Clicked="OnCloseMenuSheetClicked"
                        Margin="20,10,20,0"/>
            </Grid>
        </Border>

        <!-- MODAL CREAR -->
        <BoxView x:Name="CreateBackdrop" Grid.RowSpan="3"
                 BackgroundColor="#80000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseCreateSheetTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="CreateSheetModal" Grid.RowSpan="3"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                StrokeThickness="0"
                VerticalOptions="End" HorizontalOptions="Fill"
                IsVisible="False" Opacity="0" TranslationY="600">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.15" Offset="0,-4" Radius="20"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0,0,0,20">

                <Grid Grid.Row="0" Padding="20,20,20,10">
                    <Label Text="Crear"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                           HorizontalOptions="Center"/>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"/>

                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout x:Name="CreateItemsStack" Spacing="0" Padding="0,10,0,10"/>
                </ScrollView>

                <Button Grid.Row="3"
                        Text="Cerrar"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                        TextColor="#007AFF"
                        HeightRequest="48" CornerRadius="14"
                        FontSize="16" FontAttributes="Bold"
                        Clicked="OnCloseCreateSheetClicked"
                        Margin="20,10,20,0"/>
            </Grid>
        </Border>

        <!-- TOAST -->
        <Border x:Name="AppleToast" Grid.RowSpan="3"
                BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                StrokeThickness="0"
                HorizontalOptions="Center" VerticalOptions="Start"
                Margin="0,50,0,0" Padding="20,12"
                Opacity="0" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Label x:Name="AppleToastMessage"
                   TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}"
                   FontSize="14" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
        </Border>

    </Grid>
</ContentPage>