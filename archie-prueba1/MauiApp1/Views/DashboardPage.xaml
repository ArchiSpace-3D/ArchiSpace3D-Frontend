<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.DashboardPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}">

    <Grid>
        <!-- Blue Header Background -->
        

        <ScrollView x:Name="MainScroll" Opacity="0" TranslationY="30">            <VerticalStackLayout Spacing="25" Padding="24,50,24,20">
                <!-- HEADER: Minimalist & Clean -->
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <Label Text="Bienvenido de vuelta," FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontAttributes="Bold" TextTransform="Uppercase" CharacterSpacing="1.5"/>
                    <Label x:Name="NombreUsuarioLabel" Grid.Row="1" Text="Usuario" FontSize="32" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" Margin="0,4,0,0"/>
                    
                    <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="2" Spacing="12" VerticalOptions="Center">
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                            <Image x:Name="ThemeIconDashboard" Source="ic_moon.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnToggleThemeClicked"/></Border.GestureRecognizers>
                        </Border>

                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                            <Grid>
                                <Image Source="{AppThemeBinding Light=ic_bell.svg, Dark=ic_bell_white.svg}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Label x:Name="NotificationCountBadge" IsVisible="False" Text="0" BackgroundColor="#EF4444" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" Margin="0,8,8,0" Padding="4,1" WidthRequest="18" HeightRequest="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                            </Grid>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked"/></Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- HERO CARD: Active Project -->
                <Border x:Name="ActiveProjectCard" BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=#0B1120}" StrokeThickness="0" Padding="24">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28"/></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#0F172A, Dark=#000000}" Opacity="0.25" Offset="0,12" Radius="24"/>
                    </Border.Shadow>
                    
                    <Grid RowDefinitions="Auto,*,Auto" HeightRequest="160">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="PROYECTO ACTIVO" FontSize="11" FontAttributes="Bold" TextColor="#94A3B8" VerticalOptions="Center" CharacterSpacing="1"/>
                            <Border Grid.Column="1" BackgroundColor="#1E293B" StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Label x:Name="LblEstadoProyectoActivo" Text="Ninguno" FontSize="11" TextColor="#E2E8F0" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                        
                        <VerticalStackLayout Grid.Row="1" VerticalOptions="Center" Margin="0,10">
                            <Label x:Name="LblNombreProyectoActivo" Text="Selecciona un proyecto" FontSize="26" FontAttributes="Bold" TextColor="#FFFFFF" LineBreakMode="TailTruncation"/>
                            <Label x:Name="LblUbicacionProyectoActivo" Text="--" FontSize="14" TextColor="#94A3B8" Margin="0,4,0,0" LineBreakMode="TailTruncation"/>
                        </VerticalStackLayout>
                        
                        <HorizontalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="End">
                            <Label Text="Ver detalles" FontSize="14" FontAttributes="Bold" TextColor="#38BDF8" VerticalOptions="Center"/>
                            <Image Source="{AppThemeBinding Light=ic_arrow_right.svg, Dark=ic_arrow_right_white.svg}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnActiveProjectDetailsClicked"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Border>

                <!-- BENTO BOX: Quick Actions -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,5,0,5">
                    
                    <Border x:Name="NewProjectActionContainer" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1" Padding="20">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#000000" Opacity="0.04" Offset="0,4" Radius="12"/></Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}" StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                <Label Text="+" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0"/>
                            </Border>
                            <Label Text="Crear Proyecto" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            <Label Text="Nuevo lienzo" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenNewProjectSheetClicked"/></Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1" Padding="20">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#000000" Opacity="0.04" Offset="0,4" Radius="12"/></Border.Shadow>
                        <VerticalStackLayout Spacing="12">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}" StrokeThickness="0" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                                <Image Source="{AppThemeBinding Light=ic_join.svg, Dark=ic_join_white.svg}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Border>
                            <Label Text="Unirse" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                            <Label Text="Con invitación" FontSize="12" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenJoinCodeSheetClicked"/></Border.GestureRecognizers>
                    </Border>

                </Grid>

                <!-- RECENT PROJECTS SECTION -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <Label Text="Mis Proyectos" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" VerticalOptions="Center"/>
                    <Image Grid.Column="1" Source="{AppThemeBinding Light=ic_refresh.svg, Dark=ic_refresh_white.svg}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Opacity="0.5">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnRefreshClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>

                <ActivityIndicator x:Name="LoadingProjectsIndicator" IsRunning="True" Color="#38BDF8" HorizontalOptions="Center" Margin="0,20"/>

                <CollectionView x:Name="ProjectsCollectionView" Margin="0,10,0,0" HeightRequest="240" ItemsLayout="HorizontalList">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="220" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E293B}" Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#334155}" StrokeThickness="1" Margin="0,0,15,10" Padding="20">
                                <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#000000" Opacity="0.03" Offset="0,4" Radius="12"/></Border.Shadow>
                                
                                <Grid RowDefinitions="Auto,*,Auto">
                                    <Border HorizontalOptions="Start" BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}" StrokeThickness="0" Padding="10,4">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                        <Label Text="{Binding Estado}" FontSize="10" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" FontAttributes="Bold"/>
                                    </Border>
                                    
                                    <VerticalStackLayout Grid.Row="1" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Ubicacion}" FontSize="13" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" Margin="0,4,0,0" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                    
                                    <Button Grid.Row="2" Text="Seleccionar" BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" HeightRequest="40" CornerRadius="20" FontSize="13" FontAttributes="Bold" Clicked="OnSelectProjectClicked" CommandParameter="{Binding .}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No hay proyectos creados." TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}" HorizontalOptions="Center" Margin="0,40"/>
                    </CollectionView.EmptyView>
                </CollectionView>

                <VerticalStackLayout x:Name="NotificationsContainer" Spacing="12" Margin="0,20,0,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="DetailsBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseDetailsSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="ProjectDetailsSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Fill" Margin="25" IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="DetailsSheetCard" Spacing="15" Padding="24,20,24,40">
                
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label x:Name="SheetProjectName" Text="Nombre Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                        <Label x:Name="SheetProjectCode" Text="Código: --" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}"/>
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseDetailsSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="SheetProjectDesc" Text="Sin descripción" FontSize="14" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                                                <Label x:Name="SheetProjectUbicacion" Text="Ubicación: --" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}"/>
                        <Label x:Name="SheetProjectClient" Text="Cliente: --" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}"/>
                        <Label x:Name="SheetProjectEstado" Text="Estado: --" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Activar" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="48" CornerRadius="24" FontAttributes="Bold" Clicked="OnSetAsActiveProjectClicked"/>
                    <Button Grid.Column="1" Text="Diseño 3D" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HeightRequest="48" CornerRadius="24" FontAttributes="Bold" Clicked="OnEnterDesignClicked"/>
                </Grid>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Ver Mediciones" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1E3A8A}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#93C5FD}" HeightRequest="44" CornerRadius="22" FontAttributes="Bold" Clicked="OnVerMedicionesClicked"/>
                    <Button x:Name="BtnGenerarInvitacion" Grid.Column="1" Text="Invitar Cliente" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1E3A8A}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#93C5FD}" HeightRequest="44" CornerRadius="22" FontAttributes="Bold" Clicked="OnGenerarInvitacionClicked"/>
                </Grid>

                <Button x:Name="BtnSheetEditarProyecto" Text="Editar Proyecto" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0A4174, Dark=#93C5FD}" HeightRequest="48" FontAttributes="Bold" Clicked="OnEditarProyectoFromDetailsClicked"/>
                <Button x:Name="BtnSheetEliminarProyecto" Text="Eliminar Proyecto" BackgroundColor="Transparent" TextColor="#D32F2F" HeightRequest="48" FontAttributes="Bold" Clicked="OnEliminarProyectoFromDetailsClicked"/>
            </VerticalStackLayout>
        </Border>

        <BoxView x:Name="NewProjectBackdrop" BackgroundColor="#99000000" Opacity="0" InputTransparent="True">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="NewProjectSheetCard" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Fill" Margin="25" IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nuevo Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryNombreProyecto" Placeholder="Nombre del proyecto" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryUbicacionProyecto" Placeholder="Ubicación / Ciudad" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Crear Proyecto" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitCrearProyectoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <BoxView x:Name="EditProjectBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditProjectSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="EditProjectSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Fill" Margin="25" IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="EditProjectSheetCard" Spacing="15" Padding="24,20,24,40">
                
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Editar Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditProjectSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditNombreProyecto" Placeholder="Nombre" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditDescripcionProyecto" Placeholder="descripción" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditUbicacionProyecto" Placeholder="Ubicación" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                                  <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                      <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                      <Entry x:Name="EditPresupuestoProyecto" Placeholder="Presupuesto" Keyboard="Numeric" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                  </Border>
                  <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                      <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                      <Picker x:Name="EditEstadoProyecto" Title="Estado" TitleColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center">
                          <Picker.Items>
                              <x:String>Borrador</x:String>
                              <x:String>En Progreso</x:String>
                              <x:String>Finalizado</x:String>
                          </Picker.Items>
                      </Picker>
                  </Border>
                <Button Text="Guardar Cambios" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitEditarProyectoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <BoxView x:Name="JoinCodeBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseJoinCodeSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="JoinCodeSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Fill" Margin="25" IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Unirse a Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseJoinCodeSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Label Text="Ingresa el Código proporcionado por tu arquitecto:" FontSize="14" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}"/>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="JoinCodeEntry" Placeholder="Ej. ARQ-1234" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Vincular Proyecto" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitJoinCodeClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Measurements Sheet -->
        <BoxView x:Name="MeasurementsBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMeasurementsSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="MeasurementsSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Fill" Margin="25" IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Mediciones AR" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMeasurementsSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                
                <ActivityIndicator x:Name="LoadingMeasurementsIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" HorizontalOptions="Center" Margin="0,10"/>
                
                <CollectionView x:Name="MeasurementsCollectionView" HeightRequest="250">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" Margin="0,0,0,10" Padding="15">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding FechaFormateada}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                                        <Label Text="Distancia:" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Distancia, StringFormat='{0:F2} m'}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5" Padding="20">
                            <Label Text="No hay mediciones" TextColor="{AppThemeBinding Light=#0A4174, Dark=#93C5FD}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Usa la Regla AR para guardar medidas" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#94A3B8}" FontSize="12" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Border x:Name="AppleToast" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" FontSize="14" FontAttributes="Bold"/>
        </Border>

        <!-- Custom Alert Backdrop -->
        <BoxView x:Name="AlertBackdrop" BackgroundColor="#99000000" Opacity="0" InputTransparent="True" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseAlertClicked"/></BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="AlertModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Center" WidthRequest="320" Margin="25"
                IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#000000" Opacity="0.2" Offset="0,10" Radius="20"/></Border.Shadow>
            
            <VerticalStackLayout Spacing="10" Padding="24,30,24,24" HorizontalOptions="Center">
                <Border x:Name="AlertIconBox" BackgroundColor="#D1F4E0" StrokeThickness="0" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Border.StrokeShape><RoundRectangle CornerRadius="30"/></Border.StrokeShape>
                    <Label x:Name="AlertIconLabel" Text="?" FontSize="28" TextColor="#129740" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                </Border>

                <Label x:Name="AlertTitle" Text="ï¿½ï¿½xito!" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#121212, Dark=#FFFFFF}" HorizontalTextAlignment="Center"/>
                <Label x:Name="AlertMessage" Text="Operaciï¿½n exitosa." FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" HorizontalTextAlignment="Center" Margin="0,5,0,15"/>

                <Button x:Name="AlertButton" Text="Continuar" BackgroundColor="#A3E7C9" TextColor="#000000" HeightRequest="45" CornerRadius="22" FontAttributes="Bold" Clicked="OnCloseAlertClicked"/>
            </VerticalStackLayout>
        </Border>

        
        <controls:FloatingTabBar SelectedIndex="0" />
</Grid>
</ContentPage>








