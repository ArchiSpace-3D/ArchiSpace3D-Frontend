<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.DashboardPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ===== FILA 0: HEADER TIPO INSTAGRAM ===== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,40,20,10" VerticalOptions="Center">

            <Border x:Name="NewProjectActionContainer" Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label Text="+" FontSize="30" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-4,0,0"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenNewProjectSheetClicked"/>
                </Border.GestureRecognizers>
            </Border>

            <Border x:Name="JoinRoomActionContainer" Grid.Column="0" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center" IsVisible="False">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Label Text="🔑" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenJoinCodeSheetClicked"/>
                </Border.GestureRecognizers>
            </Border>

            <Label Grid.Column="1"
                   Text="ArchiSpace"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                   FontFamily="Serif"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <Border Grid.Column="2" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Grid>
                    <Image Source="ic_heart.svg" WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Label x:Name="NotificationCountBadge" IsVisible="False" Text="0" BackgroundColor="#EF4444" TextColor="White" FontSize="9" FontAttributes="Bold" HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0" Padding="4,1" WidthRequest="18" HeightRequest="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnNotificationsClicked"/>
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- ===== FILA 1: SALAS (HISTORIAS) ===== -->
        <Grid Grid.Row="1" HeightRequest="105" Margin="0,15,0,10">
            <ScrollView Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never"
                        VerticalScrollBarVisibility="Never">
                <HorizontalStackLayout x:Name="RoomsStack"
                                       Spacing="18"
                                       Padding="20,0,20,0"
                                       VerticalOptions="Center"/>
            </ScrollView>
        </Grid>

        <!-- ===== FILA 2: FEED DE PROYECTOS ===== -->
        <ScrollView Grid.Row="2" x:Name="MainScroll" Opacity="0" TranslationY="30">
            <VerticalStackLayout Spacing="0" Padding="0,0,0,120">

                <CollectionView x:Name="ProjectsFeedCollectionView" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <VerticalStackLayout Spacing="10" Padding="20,10,20,25">

                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                                    <Border Grid.Column="0" WidthRequest="40" HeightRequest="40"
                                            BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#334155}"
                                            StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="20"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding PrimeraLetra}" FontSize="16" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                                               HorizontalOptions="Center" VerticalOptions="Center"/>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" VerticalOptions="Center">
                                        <Label Text="{Binding Nombre}" FontSize="14" FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                               LineBreakMode="TailTruncation">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnProjectNameTapped"
                                                                      CommandParameter="{Binding .}"/>
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="{Binding Ubicacion}" FontSize="11"
                                               TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                               LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="2" Text="•••" FontSize="20"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProjectMenuTapped"
                                                                  CommandParameter="{Binding .}"/>
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>

                                <Border BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#1E293B}"
                                        StrokeThickness="0" Padding="12,6" HorizontalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12"/>
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Estado}" FontSize="11" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                                </Border>

                                <Border BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                        StrokeThickness="0" HeightRequest="300" Margin="0,5,0,0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16"/>
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Image Source="ic_construction.svg" WidthRequest="60" HeightRequest="60"
                                               HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.3"/>
                                        <Image Source="{Binding Imagenurl}" Aspect="AspectFill"
                                               HorizontalOptions="Fill" VerticalOptions="Fill"/>
                                    </Grid>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProjectImageTapped"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                </Border>

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="15" Margin="0,5,0,0">
                                    <Image Grid.Column="0" Source="ic_heart_outline.svg" WidthRequest="26" HeightRequest="26"/>
                                    <Image Grid.Column="1" Source="ic_comment.svg" WidthRequest="26" HeightRequest="26"/>
                                    <Image Grid.Column="2" Source="ic_share.svg" WidthRequest="26" HeightRequest="26"/>
                                    <Image Grid.Column="4" Source="ic_bookmark.svg" WidthRequest="26" HeightRequest="26"/>
                                </Grid>

                                <Label Text="0 aprobaciones técnicas y mediciones" FontSize="13" FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                                <Label Text="{Binding Descripcion}" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                                       LineBreakMode="WordWrap"/>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center">
                            <Image Source="ic_construction.svg" WidthRequest="60" HeightRequest="60"
                                   HorizontalOptions="Center" Opacity="0.3"/>
                            <Label Text="No hay proyectos todavía" FontSize="15" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Crea tu primer proyecto con el botón +" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

                <VerticalStackLayout x:Name="NotificationsContainer" Spacing="12" Margin="20,0,20,0"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== FILA 3: BARRA DE NAVEGACIÓN INFERIOR ===== -->
        <controls:FloatingTabBar Grid.Row="3" SelectedIndex="0" />

        <!-- ===== MODAL DETALLES PROYECTO (iOS ACTION SHEET) ===== -->
        <BoxView x:Name="DetailsBackdrop" Grid.RowSpan="4" BackgroundColor="#80000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseDetailsSheetTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="ProjectDetailsSheetModal" Grid.RowSpan="4"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                StrokeThickness="0"
                VerticalOptions="End" HorizontalOptions="Fill"
                IsVisible="False" Opacity="0" TranslationY="500">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.15" Offset="0,-4" Radius="20"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0,0,0,20">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,18,20,10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label x:Name="SheetProjectName"
                               Text="Nombre Proyecto"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                               LineBreakMode="TailTruncation"/>
                        <Label x:Name="SheetProjectCode"
                               Text="Presupuesto: --"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"/>
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="32" HeightRequest="32"
                            BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                            StrokeThickness="0"
                            VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Image Source="ic_close.svg" WidthRequest="14" HeightRequest="14"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseDetailsSheetTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"/>

                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="16" Padding="20,20,20,10">

                        <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                StrokeThickness="0"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14"/>
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="12">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Descripción" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                           TextTransform="Uppercase" CharacterSpacing="1"/>
                                    <Label x:Name="SheetProjectDesc" Text="Sin descripción" FontSize="14"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                           LineBreakMode="WordWrap"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Ubicación" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                           TextTransform="Uppercase" CharacterSpacing="1"/>
                                    <Label x:Name="SheetProjectUbicacion" Text="--" FontSize="14"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Cliente" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                           TextTransform="Uppercase" CharacterSpacing="1"/>
                                    <Label x:Name="SheetProjectClient" Text="--" FontSize="14"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Estado" FontSize="12" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                           TextTransform="Uppercase" CharacterSpacing="1"/>
                                    <Label x:Name="SheetProjectEstado" Text="--" FontSize="14"
                                           FontAttributes="Bold" TextColor="#007AFF"/>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Spacing="0">

                            <!-- Diseño 3D -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="#E8F1FF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_palette.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Diseño 3D" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEnterDesignClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                                     Margin="50,0,0,0"/>

                            <!-- Ver Mediciones -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="#E8F1FF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_ruler.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Ver Mediciones" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVerMedicionesClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                                     Margin="50,0,0,0"/>

                            <!-- Invitar Cliente -->
                            <Grid x:Name="RowInvitarCliente" ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="#E8F1FF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_mail.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Invitar Cliente" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGenerarInvitacionClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                                     Margin="50,0,0,0"/>

                            <!-- Ver Espacios Físicos -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="#E8F1FF" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_home_outline.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Ver Espacios Físicos" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVerEspaciosClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                                     Margin="50,0,0,0"/>

                            <!-- Buzón de Sugerencias -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="#FFF3E0" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_message.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Buzón de Sugerencias" FontSize="16"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnVerSugerenciasClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="SectionAdmin" Spacing="0" Margin="0,8,0,0">

                            <!-- Editar Proyecto -->
                            <Grid x:Name="RowEditarProyecto" ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_edit.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Editar Proyecto" FontSize="16"
                                       TextColor="#007AFF"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEditarProyectoFromDetailsClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"
                                     Margin="50,0,0,0"/>

                            <!-- Eliminar Proyecto -->
                            <Grid x:Name="RowEliminarProyecto" ColumnDefinitions="Auto,*,Auto" Padding="4,14" ColumnSpacing="14">
                                <Border Grid.Column="0" WidthRequest="36" HeightRequest="36"
                                        BackgroundColor="#FFE5E5" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18"/>
                                    </Border.StrokeShape>
                                    <Image Source="ic_trash.svg" WidthRequest="20" HeightRequest="20"
                                           HorizontalOptions="Center" VerticalOptions="Center"/>
                                </Border>
                                <Label Grid.Column="1" Text="Eliminar Proyecto" FontSize="16"
                                       TextColor="#FF3B30"
                                       VerticalOptions="Center"/>
                                <Image Grid.Column="2" Source="ic_chevron.svg" WidthRequest="16" HeightRequest="16"
                                       VerticalOptions="Center"/>
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnEliminarProyectoFromDetailsClicked"/>
                                </Grid.GestureRecognizers>
                            </Grid>

                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="3"
                        Text="Cerrar"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                        TextColor="#007AFF"
                        HeightRequest="48" CornerRadius="14" FontSize="16" FontAttributes="Bold"
                        Clicked="OnCloseDetailsSheetClicked"
                        Margin="20,10,20,0"/>
            </Grid>
        </Border>

        <!-- ===== MODAL NUEVO PROYECTO ===== -->
        <BoxView x:Name="NewProjectBackdrop" Grid.RowSpan="4" BackgroundColor="#80000000" Opacity="0" InputTransparent="True">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="NewProjectSheetCard" Grid.RowSpan="4"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C1E}"
                StrokeThickness="0"
                VerticalOptions="End" HorizontalOptions="Fill"
                IsVisible="False" Opacity="0" TranslationY="400">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28,28,0,0"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.15" Offset="0,-4" Radius="20"/>
            </Border.Shadow>

            <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="0,0,0,20">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="20,16">
                    <Label Grid.Column="0" Text="Cancelar" FontSize="16" TextColor="#007AFF" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Label Grid.Column="1" Text="Nuevo Proyecto" FontSize="17" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                           HorizontalOptions="Center" VerticalOptions="Center"/>

                    <Label Grid.Column="2" Text="Crear" FontSize="16" FontAttributes="Bold" TextColor="#007AFF" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSubmitCrearProyectoClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <BoxView Grid.Row="1" HeightRequest="1"
                         BackgroundColor="{AppThemeBinding Light=#E5E5EA, Dark=#38383A}"/>

                <ScrollView Grid.Row="2" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="20" Padding="20,20,20,10">

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Imagen" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="180">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Grid>
                                    <Image x:Name="ImgPreviewProyecto" Aspect="AspectFill"
                                           HorizontalOptions="Fill" VerticalOptions="Fill" IsVisible="False"/>
                                    <VerticalStackLayout x:Name="ImgPlaceholderProyecto" Spacing="6"
                                                         HorizontalOptions="Center" VerticalOptions="Center">
                                        <Image Source="ic_camera.svg" WidthRequest="36" HeightRequest="36"
                                               HorizontalOptions="Center" Opacity="0.5"/>
                                        <Label Text="Toca para agregar una foto" FontSize="13"
                                               TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                               HorizontalTextAlignment="Center"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSeleccionarImagenProyectoClicked"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Label x:Name="LblNombreImagenProyecto" Text="" FontSize="12"
                                   TextColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                   LineBreakMode="MiddleTruncation" IsVisible="False"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nombre" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#6D6D72, Dark=#8E8E93}"
                                   Margin="8,0,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                                    StrokeThickness="0" HeightRequest="50">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Entry x:Name="EntryNombreProyecto" Placeholder="Ej. Casa Los Robles"
                                       PlaceholderColor="{AppThemeBinding Light=#8E8E93, Dark=#8E8E93}"
                                       TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                                       Margin="15,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>

