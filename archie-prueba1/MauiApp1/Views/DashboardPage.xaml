                            <CollectionView.EmptyView>
                                <VerticalStackLayout Padding="40" Spacing="10" HorizontalOptions="Center">
                                    <Image Source="ic_ruler.svg" WidthRequest="60" HeightRequest="60"
                                           HorizontalOptions="Center" Opacity="0.4"/>
                                    <Label Text="No hay mediciones" FontSize="15" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"
                                           HorizontalTextAlignment="Center"/>
                                    <Label Text="Usa la Regla AR para guardar medidas" FontSize="12"
                                           TextColor="{AppThemeBinding Light=#94A3B8, Dark=#64748B}"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                        </CollectionView>

                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="3" Text="Cerrar"
                        BackgroundColor="{AppThemeBinding Light=#F2F2F7, Dark=#2C2C2E}"
                        TextColor="#007AFF"
                        HeightRequest="48" CornerRadius="14" FontSize="16" FontAttributes="Bold"
                        Clicked="OnCloseMeasurementsSheetClicked"
                        Margin="20,10,20,0"/>
            </Grid>
        </Border>

        <!-- ===== TOAST ===== -->
        <Border x:Name="AppleToast" Grid.RowSpan="4"
                BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                StrokeThickness="0"
                HorizontalOptions="Center" VerticalOptions="Start"
                Margin="0,40,0,0" Padding="20,12"
                Opacity="0" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Label x:Name="AppleToastMessage"
                   TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}"
                   FontSize="14" FontAttributes="Bold"/>
        </Border>

        <!-- ===== ALERT ===== -->
        <BoxView x:Name="AlertBackdrop" Grid.RowSpan="4" BackgroundColor="#99000000"
                 Opacity="0" InputTransparent="True" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseAlertClicked"/>
            </BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="AlertModal" Grid.RowSpan="4"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                StrokeThickness="0" VerticalOptions="Center" HorizontalOptions="Center"
                WidthRequest="320" Margin="25" IsVisible="False" Opacity="0" Scale="0.9">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="24"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.2" Offset="0,10" Radius="20"/>
            </Border.Shadow>
            <VerticalStackLayout Spacing="10" Padding="24,30,24,24" HorizontalOptions="Center">
                <Border x:Name="AlertIconBox" BackgroundColor="#D1F4E0" StrokeThickness="0"
                        WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <Image x:Name="AlertIconImage" Source="ic_check.svg" WidthRequest="30" HeightRequest="30"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label x:Name="AlertTitle" Text="¡Éxito!" FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#121212, Dark=#FFFFFF}" HorizontalTextAlignment="Center"/>
                <Label x:Name="AlertMessage" Text="Operación exitosa." FontSize="14"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                       HorizontalTextAlignment="Center" Margin="0,5,0,15"/>
                <Button x:Name="AlertButton" Text="Continuar" BackgroundColor="#A3E7C9" TextColor="#000000"
                        HeightRequest="45" CornerRadius="22" FontAttributes="Bold" Clicked="OnCloseAlertClicked"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>