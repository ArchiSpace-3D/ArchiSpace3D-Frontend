<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.DesignPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#121212}">

    <Grid>
        <!-- The Fullscreen 3D/2D Viewer -->
        <WebView x:Name="ViewerWebView" 
                 HorizontalOptions="Fill" 
                 VerticalOptions="Fill" />

        <!-- Floating Top Bar -->
        <Border BackgroundColor="{AppThemeBinding Light=#EEFFFFFF, Dark=#EE121212}" 
                StrokeThickness="0" 
                HorizontalOptions="Fill" 
                VerticalOptions="Start" 
                Margin="20,40,20,0"
                Padding="15,10">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.1" Offset="0,4" Radius="10"/>
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image Source="ic_back.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Image.GestureRecognizers>
                </Image>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Editor de Espacios" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HorizontalOptions="Center"/>
                    <Label x:Name="ModoLabel" Text="Modo: 2D Plano" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" HorizontalOptions="Center"/>
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="3D" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}" TextColor="White" CornerRadius="12" WidthRequest="40" HeightRequest="40" Padding="0" Clicked="OnToggle3DClicked"/>
            </Grid>
        </Border>

        <!-- Floating Action Buttons (Right Side) -->
        <VerticalStackLayout HorizontalOptions="End" VerticalOptions="Center" Spacing="15" Margin="0,0,20,0">
            <Button x:Name="BtnModoMover" Text="✋" FontSize="20" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" TextColor="#001D39" Clicked="OnModoMoverClicked">
    <Button.Shadow><Shadow Brush="#000000" Opacity="0.15" Offset="0,5" Radius="10"/></Button.Shadow>
</Button>
            <Button x:Name="BtnModoLibre" Text="✏️" FontSize="20" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" TextColor="#001D39" Clicked="OnModoLibreClicked">
                <Button.Shadow><Shadow Brush="#000000" Opacity="0.15" Offset="0,5" Radius="10"/></Button.Shadow>
            </Button>
            <Button x:Name="BtnModoMuros" Text="📏" FontSize="20" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" TextColor="#001D39" Clicked="OnModoMurosClicked">
                <Button.Shadow><Shadow Brush="#000000" Opacity="0.15" Offset="0,5" Radius="10"/></Button.Shadow>
            </Button>
            <Button x:Name="BtnModoModulos" Text="📦" FontSize="20" WidthRequest="50" HeightRequest="50" CornerRadius="25" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}" TextColor="#001D39" Clicked="OnModoModulosClicked">
                <Button.Shadow><Shadow Brush="#000000" Opacity="0.15" Offset="0,5" Radius="10"/></Button.Shadow>
            </Button>
        </VerticalStackLayout>

        <!-- Floating Bottom Panel (Contextual) -->
        <Border x:Name="ContextPanel" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" 
                StrokeThickness="0" HorizontalOptions="Fill" VerticalOptions="End" Margin="20,0,20,40" Padding="20">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#000000" Opacity="0.15" Offset="0,-5" Radius="15"/></Border.Shadow>
            
            <VerticalStackLayout Spacing="10">
                <Label x:Name="ContextTitle" Text="Dibujo Libre Activado" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                <Label x:Name="ContextDesc" Text="Dibuja con tu dedo sobre la cuadrícula para generar los muros automáticamente." FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                    <Button Text="Deshacer" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#333333}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" CornerRadius="12" Clicked="OnUndoClicked"/>
                    <Button Grid.Column="1" Text="Guardar Plano" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}" TextColor="White" CornerRadius="12" Clicked="OnSavePlanClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <controls:FloatingTabBar SelectedIndex="1" />
</Grid>
</ContentPage>

