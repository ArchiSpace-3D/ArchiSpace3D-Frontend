<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.SpacesPage"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1120}"
             Title="Espacios Físicos">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,100" Spacing="25">
                
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Espacios Físicos" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Label Text="Áreas y habitaciones del proyecto" FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#1E293B}" WidthRequest="44" HeightRequest="44" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="22"/></Border.StrokeShape>
                        <Image Source="ic_close_white.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseClicked"/></Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Button x:Name="BtnNuevoEspacio" Text="Nuevo Espacio" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontAttributes="Bold" Clicked="OnNewSpaceClicked"/>

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" HorizontalOptions="Center" Margin="0,20"/>
                
                <CollectionView x:Name="SpacesCollectionView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" Margin="0,0,0,12" Padding="15">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#000000" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                                
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Descripcion}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Fechacaptura, StringFormat='{0:dd/MM/yyyy}'}" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="12"/>
                                    </VerticalStackLayout>
                                    
                                    <HorizontalStackLayout Grid.Row="1" Spacing="10" Margin="0,10,0,0">
                                        <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#1E1E1E}" StrokeThickness="0" Padding="10,4">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                            <Label Text="{Binding DimensionesTexto}" FontSize="11" TextColor="{AppThemeBinding Light=#0A4174, Dark=#94A3B8}" FontAttributes="Bold"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    
                                    <Border Grid.Column="1" Grid.RowSpan="2" IsVisible="{Binding PuedeEliminar}" BackgroundColor="#FFF0F0" StrokeThickness="0" WidthRequest="36" HeightRequest="36" VerticalOptions="Center" HorizontalOptions="End">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="18"/></Border.StrokeShape>
                                        <Image Source="ic_trash.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" HorizontalOptions="Center"/>
                                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnDeleteSpaceClicked" CommandParameter="{Binding .}"/></Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                            <Label Text="Sin espacios físicos" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label x:Name="LblEmptySpacesSubtitle" Text="Aún no se han registrado áreas en este proyecto." TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="SheetBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False" InputTransparent="True">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="NewSpaceSheet" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" HorizontalOptions="Fill" Margin="0" IsVisible="False" Opacity="0" TranslationY="500">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nuevo Espacio" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="{AppThemeBinding Light=ic_close.svg, Dark=ic_close_white.svg}" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryDesc" Placeholder="Nombre (ej. Sala Principal)" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="EntryLargo" Placeholder="Largo (m)" Keyboard="Numeric" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="12,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="EntryAncho" Placeholder="Ancho (m)" Keyboard="Numeric" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="12,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="EntryAlto" Placeholder="Alto (m)" Text="2.5" Keyboard="Numeric" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="12,0" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <Button Text="Guardar Espacio" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontAttributes="Bold" Clicked="OnSubmitSpaceClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
