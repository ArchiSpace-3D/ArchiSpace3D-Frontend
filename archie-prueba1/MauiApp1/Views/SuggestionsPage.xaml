<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:MauiApp1.Views"
             x:Class="MauiApp1.Views.SuggestionsPage"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0B1120}"
             Title="Sugerencias">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,100" Spacing="25">
                
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Ideas y Sugerencias" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"/>
                        <Label Text="Buzón de ideas del proyecto" FontSize="14" TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" WidthRequest="48" HeightRequest="48" StrokeThickness="0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                        <Image Source="{AppThemeBinding Light=ic_close.svg, Dark=ic_close.svg}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding AppTheme}" Value="Light">
                                    <Setter Property="Source" Value="ic_close.svg"/>
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseClicked"/></Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Button Text="+ Enviar Sugerencia" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontAttributes="Bold" Clicked="OnNewSuggestionClicked"/>

                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" HorizontalOptions="Center" Margin="0,20"/>
                
                <CollectionView x:Name="SuggestionsCollectionView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" Margin="0,0,0,12" Padding="15">
                                <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#000000" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                                
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="{Binding Titulo}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="16" FontAttributes="Bold"/>
                                        <Label Text="{Binding Descripcion}" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="13"/>
                                    </VerticalStackLayout>
                                    
                                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#1E1E1E}" StrokeThickness="0" Padding="10,5" VerticalOptions="Start">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                        <Label Text="{Binding Estado}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0A4174, Dark=#93C5FD}"/>
                                    </Border>

                                    <!-- Admin Options -->
                                    <HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" Margin="0,15,0,0" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type views:SuggestionsPage}}, Path=IsArquitecto}">
                                        <Button Text="Aprobar" HeightRequest="35" FontSize="12" CornerRadius="17" BackgroundColor="#E8F5E9" TextColor="#2E7D32" CommandParameter="{Binding .}" Clicked="OnApproveClicked"/>
                                        <Button Text="Rechazar" HeightRequest="35" FontSize="12" CornerRadius="17" BackgroundColor="#FFEBEE" TextColor="#C62828" CommandParameter="{Binding .}" Clicked="OnRejectClicked"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                            <Label Text="Buzón vacío" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="No hay ideas ni sugerencias aún." TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="SheetBackdrop" BackgroundColor="#99000000" Opacity="0" InputTransparent="True">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="NewSuggestionSheet" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" HorizontalOptions="Fill" Margin="0" IsVisible="False" Opacity="0" TranslationY="500">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Enviar Idea" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryTitulo" Placeholder="Título de la idea (ej. Pintar de azul)" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="100">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Editor x:Name="EntryDesc" Placeholder="Detalles..." PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,10"/>
                </Border>

                <Button Text="Enviar" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontAttributes="Bold" Clicked="OnSubmitSuggestionClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
