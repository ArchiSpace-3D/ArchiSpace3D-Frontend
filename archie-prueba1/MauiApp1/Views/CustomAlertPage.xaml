<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.CustomAlertPage"
             BackgroundColor="#B3000000">

    <Grid>
        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Margin="40,0"
                Padding="30,40,30,30"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="30" Opacity="0.15" />
            </Border.Shadow>
            
            <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
                
                <Border x:Name="IconBg" WidthRequest="64" HeightRequest="64" StrokeThickness="0" HorizontalOptions="Center" Margin="0,0,0,24">
                    <Border.StrokeShape><RoundRectangle CornerRadius="32"/></Border.StrokeShape>
                    <Label x:Name="IconLabel" Text="✓" FontSize="32" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold"/>
                </Border>
                
                <Label x:Name="TitleLabel" Text="Title" FontSize="22" FontAttributes="Bold" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}" Margin="0,0,0,12"/>
                
                <Label x:Name="MessageLabel" Text="Message" FontSize="15" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" LineHeight="1.5" Margin="0,0,0,32"/>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                    <Button x:Name="CancelButton" Text="Cancelar" Grid.Column="0" IsVisible="False" 
                            BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#374151}" 
                            TextColor="{AppThemeBinding Light=#374151, Dark=#F9FAFB}" 
                            CornerRadius="25" HeightRequest="50" FontAttributes="Bold" Clicked="OnCancelClicked"/>
                            
                    <Button x:Name="ActionButton" Text="Dismiss" Grid.Column="1" Grid.ColumnSpan="2" 
                            CornerRadius="25" HeightRequest="50" FontAttributes="Bold" Clicked="OnDismissClicked"/>
                </Grid>
                
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
