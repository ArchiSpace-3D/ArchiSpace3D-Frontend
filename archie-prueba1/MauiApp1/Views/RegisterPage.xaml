<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid x:Name="RootGrid">
        <!-- Background Image -->
        <Image x:Name="BgImage" Source="bg_login.jpg" Aspect="AspectFill" VerticalOptions="Fill" HorizontalOptions="Fill" Opacity="0.85"/>
        
        <!-- Glass/White Form Card -->
        <Border x:Name="FormCard" BackgroundColor="{AppThemeBinding Light=#EEFFFFFF, Dark=#EE121212}" 
                Stroke="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="1" 
                VerticalOptions="Center" HorizontalOptions="Fill" Margin="24,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>

            <ScrollView VerticalScrollBarVisibility="Never">
                <VerticalStackLayout x:Name="MainLayout" Spacing="15" Padding="25,30" MaximumWidthRequest="400" HorizontalOptions="Center" VerticalOptions="Center">
                    
                    <Image Source="splash.svg" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" Margin="0,0,0,5"/>
                    
                    <Label Text="Crear Cuenta" FontSize="24" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nombre" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                            <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                                <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                                <Entry x:Name="RegNombreEntry" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="20,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Apellido" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                            <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                                <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                                <Entry x:Name="RegApellidoEntry" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="20,0" VerticalOptions="Center"/>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Correo electrónico" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                            <Entry x:Name="RegEmailEntry" Keyboard="Email" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="20,0" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Contraseña" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" Padding="20,0,15,0">
                                <Entry x:Name="RegPasswordEntry" IsPassword="True" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" VerticalOptions="Center"/>
                                <Image Grid.Column="1" x:Name="RegPasswordToggleIcon" Source="ic_eye_off.svg" WidthRequest="20" HeightRequest="20" Opacity="0.5" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnToggleRegPasswordVisibility"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="¿Qué rol tienes?" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                            <Picker x:Name="RegRolPicker" Title="Selecciona tu rol" TitleColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="20,0" VerticalOptions="Center">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Cliente</x:String>
                                        <x:String>Arquitecto</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="BtnSubmitRegister" Text="Crear Cuenta" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}" TextColor="#FFFFFF" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitRegisterClicked" Margin="0,10,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#0A4174" Opacity="0.3" Offset="0,5" Radius="10"/>
                        </Button.Shadow>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                        <Label Text="¿Ya tienes cuenta?" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="13" VerticalOptions="Center"/>
                        <Label Text="Inicia sesión" TextColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
