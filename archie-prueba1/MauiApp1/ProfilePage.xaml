<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.ProfilePage"
             BackgroundColor="#DCD7C9"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Header Superior Fijo Apple -->
        <Border VerticalOptions="Start" HeightRequest="130" BackgroundColor="#2C3639" StrokeThickness="0" Margin="0,-20,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,32,32" />
            </Border.StrokeShape>
            <Grid Padding="24,40,24,10" VerticalOptions="End">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Perfil de Usuario" FontSize="24" FontAttributes="Bold" TextColor="#DCD7C9" />
                    <Label Text="Cuenta y preferencias del sistema" FontSize="13" TextColor="#A27B5B" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Contenido Desplazable -->
        <ScrollView Margin="0,120,0,0" Padding="16,10,16,30">
            <VerticalStackLayout Spacing="20">

                <!-- Tarjeta de Identidad Apple -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="24">
                    <Border.StrokeShape><RoundRectangle CornerRadius="28" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#2C3639" Offset="0,6" Radius="16" Opacity="0.08" /></Border.Shadow>
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
                        <!-- Avatar Iniciales -->
                        <Border WidthRequest="80" HeightRequest="80" BackgroundColor="#2C3639" Stroke="#A27B5B" StrokeThickness="2">
                            <Border.StrokeShape><RoundRectangle CornerRadius="40"/></Border.StrokeShape>
                            <Label x:Name="AvatarInitialsLabel" Text="AS" FontSize="28" FontAttributes="Bold" TextColor="#DCD7C9" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>

                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label x:Name="NombreUsuarioLabel" Text="Usuario" FontSize="22" FontAttributes="Bold" TextColor="#2C3639" HorizontalTextAlignment="Center"/>
                            <Label x:Name="EmailUsuarioLabel" Text="email@dominio.com" FontSize="14" TextColor="#7A8485" HorizontalTextAlignment="Center"/>
                            <Border BackgroundColor="#3F4E4F" Padding="12,4" HorizontalOptions="Center" Margin="0,6,0,0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Label x:Name="RolUsuarioLabel" Text="Arquitecto" FontSize="12" FontAttributes="Bold" TextColor="#DCD7C9"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Ficha de Datos Personales -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#2C3639" Offset="0,4" Radius="12" Opacity="0.06" /></Border.Shadow>
                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Datos Registrados" FontSize="17" FontAttributes="Bold" TextColor="#2C3639"/>
                            <Button Grid.Column="1" Text="Editar" HeightRequest="32" CornerRadius="16" Padding="14,0"
                                    BackgroundColor="#A27B5B" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold"
                                    Clicked="OnOpenEditProfileSheetClicked"/>
                        </Grid>

                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="Teléfono:" FontSize="13" TextColor="#7A8485" WidthRequest="100"/>
                                <Label Grid.Column="1" x:Name="TelefonoLabel" Text="No especificado" FontSize="13" FontAttributes="Bold" TextColor="#2C3639"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F0ECE1"/>

                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="Dirección:" FontSize="13" TextColor="#7A8485" WidthRequest="100"/>
                                <Label Grid.Column="1" x:Name="DireccionLabel" Text="No especificada" FontSize="13" FontAttributes="Bold" TextColor="#2C3639"/>
                            </Grid>
                            <BoxView HeightRequest="1" Color="#F0ECE1"/>

                            <Grid ColumnDefinitions="Auto,*">
                                <Label Text="Documento:" FontSize="13" TextColor="#7A8485" WidthRequest="100"/>
                                <Label Grid.Column="1" x:Name="DocumentoLabel" Text="No especificado" FontSize="13" FontAttributes="Bold" TextColor="#2C3639"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Información del Servidor & Sesión -->
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24" /></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#2C3639" Offset="0,4" Radius="12" Opacity="0.06" /></Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Conexión y Servidor" FontSize="17" FontAttributes="Bold" TextColor="#2C3639"/>
                        <Label x:Name="ServerUrlLabel" Text="http://..." FontSize="13" TextColor="#3F4E4F"/>
                        <Label x:Name="SessionIdLabel" Text="ID de Usuario: --" FontSize="12" TextColor="#7A8485"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Botón Cerrar Sesión Apple -->
                <Button Text="Cerrar Sesión" BackgroundColor="#B84A39" TextColor="#FFFFFF"
                        HeightRequest="52" CornerRadius="18" FontSize="15" FontAttributes="Bold"
                        Clicked="OnLogoutClicked" Margin="0,10,0,10"/>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ==================== APPLE BOTTOM SHEET: EDITAR PERFIL ==================== -->
        <Grid x:Name="EditProfileSheetModal" IsVisible="False" InputTransparent="False">
            <BoxView BackgroundColor="#99000000" Opacity="0" x:Name="EditProfileBackdrop">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseEditProfileSheetClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="EditProfileSheetCard" VerticalOptions="End" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="24,14,24,30">
                <Border.StrokeShape><RoundRectangle CornerRadius="28,28,0,0" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <BoxView WidthRequest="36" HeightRequest="5" CornerRadius="2.5" Color="#DCD7C9" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Editar Datos de Perfil" FontSize="20" FontAttributes="Bold" TextColor="#2C3639"/>
                        <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="22" HeightRequest="22">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseEditProfileSheetClicked"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry x:Name="EditNombreEntry" Placeholder="Nombre" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                        <Entry Grid.Column="1" x:Name="EditApellidoEntry" Placeholder="Apellido" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                    </Grid>

                    <Entry x:Name="EditTelefonoEntry" Placeholder="Teléfono" Keyboard="Telephone" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                    <Entry x:Name="EditDireccionEntry" Placeholder="Dirección" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                    <Entry x:Name="EditDocumentoEntry" Placeholder="Número de Documento" Keyboard="Numeric" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>

                    <Button Text="Guardar Cambios" BackgroundColor="#A27B5B" TextColor="#FFFFFF" CornerRadius="16" HeightRequest="50" FontAttributes="Bold" Clicked="OnGuardarPerfilClicked"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== APPLE TOAST ==================== -->
        <Border x:Name="AppleToast" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,50,0,0"
                BackgroundColor="#2C3639" Stroke="#A27B5B" StrokeThickness="1" Padding="20,12" IsVisible="False" Opacity="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.2"/></Border.Shadow>
            <Label x:Name="AppleToastMessage" Text="" FontSize="14" FontAttributes="Bold" TextColor="#DCD7C9" HorizontalTextAlignment="Center"/>
        </Border>
    </Grid>
</ContentPage>
