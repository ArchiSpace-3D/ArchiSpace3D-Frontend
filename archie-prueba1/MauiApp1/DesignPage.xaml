<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DesignPage"
             Title="Diseño 3D"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="20,20,20,40">
                
                <!-- Header -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Configuración de Espacio" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Label Text="Define la estructura paso a paso." FontSize="14" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                </VerticalStackLayout>

                <!-- Active Project Banner -->
                <Border BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1E1E1E}" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Source="nav_layers.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Proyecto Seleccionado" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                            <Label x:Name="LblProyectoDesign" Text="Ninguno" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- PASO 1: PLANTA -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="Paso 1: Definir Planta / Habitación" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Label Text="Establece el área de trabajo y la altura del techo en metros." FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                    
                    <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" Padding="20">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                        <VerticalStackLayout Spacing="15">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                                <VerticalStackLayout>
                                    <Label Text="Frente / Ancho (m)" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="0,0,0,5"/>
                                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="45">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <Entry x:Name="AnchoEntry" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="10,0"/>
                                    </Border>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1">
                                    <Label Text="Fondo / Largo (m)" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="0,0,0,5"/>
                                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="45">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                        <Entry x:Name="LargoEntry" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="10,0"/>
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>
                            
                            <Label Text="Altura del Techo (m)" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="0,5,0,0"/>
                            <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="45">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <Entry x:Name="AltoEntry" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="10,0"/>
                            </Border>

                            <Button Text="Guardar Perímetro" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" CornerRadius="22" HeightRequest="45" FontAttributes="Bold" Clicked="OnGuardarFisicoClicked" Margin="0,10,0,0"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- PASO 2: ESTRUCTURA -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Paso 2: Estructura Base" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                            <Label Text="Agrega puertas, ventanas o muros." FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+ Estructura" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1E1E1E}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" CornerRadius="15" HeightRequest="35" Padding="15,0" FontAttributes="Bold" VerticalOptions="Center" Clicked="OnAddElementoClicked"/>
                    </Grid>
                    <VerticalStackLayout x:Name="ElementosList" Spacing="10" Margin="0,10,0,0"/>
                </VerticalStackLayout>

                <!-- PASO 3: MOBILIARIO -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout>
                            <Label Text="Paso 3: Decoración y Mobiliario" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                            <Label Text="Importa modelos 3D al espacio." FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        </VerticalStackLayout>
                        <Button Grid.Column="1" Text="+ Modelo 3D" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1E1E1E}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" CornerRadius="15" HeightRequest="35" Padding="15,0" FontAttributes="Bold" VerticalOptions="Center" Clicked="OnImportModelClicked"/>
                    </Grid>
                    <VerticalStackLayout x:Name="ModelosList" Spacing="10" Margin="0,10,0,0"/>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Sheet Estructura -->
        <BoxView x:Name="ElementBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseElementSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="ElementSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="{AppThemeBinding Light=#BDD8E9, Dark=#444444}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nueva Estructura" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseElementSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Picker x:Name="TipoElementoPicker" Title="Selecciona el tipo..." TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TitleColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="15,0">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Puerta</x:String>
                                <x:String>Ventana</x:String>
                                <x:String>Pilar</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="AltoElementoEntry" Placeholder="Alto (m)" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="15,0"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="AnchoElementoEntry" Placeholder="Ancho (m)" Keyboard="Numeric" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="15,0"/>
                    </Border>
                </Grid>

                <Button Text="Guardar Elemento" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitElementoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
