<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DesignPage"
             Title="Diseño 3D"
             BackgroundColor="#F4F6F8">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="20" Padding="20">
                
                <Label Text="Configurar Espacio" FontSize="24" FontAttributes="Bold" TextColor="#001D39"/>
                <Label Text="Ajusta los parámetros físicos y estructurales." FontSize="14" TextColor="#6EA2B3"/>

                <!-- Active Project Banner -->
                <Border BackgroundColor="#E8F1F8" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Source="nav_layers.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center" Margin="0,0,10,0"/>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Proyecto Seleccionado" FontSize="12" TextColor="#6EA2B3"/>
                            <Label x:Name="LblProyectoDesign" Text="Ninguno" FontSize="16" FontAttributes="Bold" TextColor="#0A4174"/>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Physical Config -->
                <Label Text="Características Físicas" FontSize="16" FontAttributes="Bold" TextColor="#001D39" Margin="0,10,0,0"/>
                
                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#001D39" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                    <VerticalStackLayout Spacing="15">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="15">
                            <VerticalStackLayout>
                                <Label Text="Alto (cm)" FontSize="12" TextColor="#6EA2B3" Margin="0,0,0,5"/>
                                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="45">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Entry x:Name="AltoEntry" Keyboard="Numeric" TextColor="#001D39" Margin="10,0"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Ancho (cm)" FontSize="12" TextColor="#6EA2B3" Margin="0,0,0,5"/>
                                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="45">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                    <Entry x:Name="AnchoEntry" Keyboard="Numeric" TextColor="#001D39" Margin="10,0"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        
                        <Label Text="Largo (cm)" FontSize="12" TextColor="#6EA2B3" Margin="0,5,0,0"/>
                        <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="45">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Entry x:Name="LargoEntry" Keyboard="Numeric" TextColor="#001D39" Margin="10,0"/>
                        </Border>

                        <Button Text="Guardar Dimensiones" BackgroundColor="#001D39" TextColor="#FFFFFF" CornerRadius="22" HeightRequest="45" FontAttributes="Bold" Clicked="OnGuardarFisicoClicked" Margin="0,10,0,0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Structural List -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <Label Text="Elementos Estructurales" FontSize="16" FontAttributes="Bold" TextColor="#001D39" VerticalOptions="Center"/>
                    <Button Grid.Column="1" Text="+ Añadir" BackgroundColor="#E8F1F8" TextColor="#0A4174" CornerRadius="15" HeightRequest="30" Padding="15,0" FontAttributes="Bold" Clicked="OnAddElementoClicked"/>
                </Grid>

                <VerticalStackLayout x:Name="ElementosList" Spacing="10"/>

                <!-- Modelos 3D -->
                <Label Text="Modelos 3D del Espacio" FontSize="16" FontAttributes="Bold" TextColor="#001D39" Margin="0,10,0,0"/>
                <VerticalStackLayout x:Name="ModelosList" Spacing="10"/>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- New Element Sheet -->
        <BoxView x:Name="ElementBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseElementSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="ElementSheetModal" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="#BDD8E9" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nuevo Elemento" FontSize="20" FontAttributes="Bold" TextColor="#001D39"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseElementSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Picker x:Name="TipoElementoPicker" Title="Tipo de elemento" TextColor="#001D39" TitleColor="#6EA2B3" Margin="15,0">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Puerta</x:String>
                                <x:String>Ventana</x:String>
                                <x:String>Pilar</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="AltoElementoEntry" Placeholder="Alto" Keyboard="Numeric" TextColor="#001D39" PlaceholderColor="#6EA2B3" Margin="15,0"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                        <Entry x:Name="AnchoElementoEntry" Placeholder="Ancho" Keyboard="Numeric" TextColor="#001D39" PlaceholderColor="#6EA2B3" Margin="15,0"/>
                    </Border>
                </Grid>

                <Button Text="Guardar Elemento" BackgroundColor="#0A4174" TextColor="#FFFFFF" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitElementoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
