<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="24,18,24,28"
                                  HorizontalOptions="Center"
                                  MaximumWidthRequest="420">

                <!-- Barra superior: volver -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,18">
                    <Border WidthRequest="38" HeightRequest="38"
                            BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}"
                            StrokeThickness="0" HorizontalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="19"/>
                        </Border.StrokeShape>
                        <Label Text="&#8592;" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Encabezado -->
                <Border WidthRequest="88" HeightRequest="88" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}"
                        HorizontalOptions="Center" Margin="0,0,0,16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="44"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.08" Offset="0,6" Radius="14"/>
                    </Border.Shadow>
                    <Image Source="registro.png" Aspect="AspectFill" WidthRequest="88" HeightRequest="88"/>
                </Border>

                <Label Text="Crear Cuenta" FontSize="24" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label Text="Únete a ArchiSpace" FontSize="13"
                       TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                       HorizontalOptions="Center" Margin="0,4,0,32"/>

                <!-- Sección: Datos personales -->
                <Label Text="DATOS PERSONALES" FontSize="11" FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                       Margin="4,0,0,10"/>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,0,0,14">
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="54">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Entry x:Name="RegNombreEntry" Placeholder="Nombre"
                               TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                               Margin="16,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="54">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Entry x:Name="RegApellidoEntry" Placeholder="Apellido"
                               TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                               Margin="16,0" VerticalOptions="Center"/>
                    </Border>
                </Grid>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="54" Margin="0,0,0,26">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*" Padding="16,0">
                        <Image Source="nav_user.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Opacity="0.5"/>
                        <Entry Grid.Column="1" x:Name="RegEmailEntry" Placeholder="Correo Electrónico"
                               TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                               Keyboard="Email" Margin="10,0,0,0" VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Sección: Acceso -->
                <Label Text="ACCESO" FontSize="11" FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                       Margin="4,0,0,10"/>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="54" Margin="0,0,0,26">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0">
                        <Image Source="nav_layers.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Opacity="0.5"/>
                        <Entry Grid.Column="1" x:Name="RegPasswordEntry" Placeholder="Contraseña"
                               TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                               PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                               IsPassword="True" Margin="10,0,0,0" VerticalOptions="Center"/>
                        <Image Grid.Column="2" x:Name="RegPasswordToggleIcon" Source="ic_eye_off.svg"
                               WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Opacity="0.5" Margin="5,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleRegPasswordVisibility"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>

                <!-- Sección: Tipo de cuenta -->
                <Label Text="TIPO DE CUENTA" FontSize="11" FontAttributes="Bold"
                       CharacterSpacing="1.2"
                       TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                       Margin="4,0,0,10"/>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="58" Margin="0,0,0,30">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto,*,Auto" Padding="16,0">
                        <Border WidthRequest="30" HeightRequest="30" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#E4ECF2, Dark=#1B2A38}"
                                VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Label Text="&#128100;" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <Picker Grid.Column="1" x:Name="RegRolPicker" Title="Selecciona tu rol"
                                TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                TitleColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                FontAttributes="Bold" FontSize="15"
                                Margin="12,0,0,0" VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Cliente</x:String>
                                    <x:String>Arquitecto</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                        <Label Grid.Column="2" Text="&#8964;" FontSize="16"
                               TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                               VerticalOptions="Center" InputTransparent="True"/>
                    </Grid>
                </Border>

                <Button x:Name="BtnSubmitRegister" Text="Crear Cuenta"
                        BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}"
                        TextColor="#FFFFFF" HeightRequest="54" CornerRadius="16"
                        FontSize="16" FontAttributes="Bold" Clicked="OnSubmitRegisterClicked">
                    <Button.Shadow>
                        <Shadow Brush="#0A4174" Opacity="0.25" Offset="0,6" Radius="12"/>
                    </Button.Shadow>
                </Button>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,16,0,0">
                    <Label Text="¿Ya tienes cuenta?" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="14" VerticalOptions="Center"/>
                    <Label Text="Inicia sesión" TextColor="#0A4174" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#0A4174" WidthRequest="50" HeightRequest="50"/>
                <Label x:Name="LoadingLabel" Text="Creando cuenta..." TextColor="#001D39" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
