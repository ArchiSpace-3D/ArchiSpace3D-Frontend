<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.RegisterPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="24,20,24,20"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  MaximumWidthRequest="400">

                <Border WidthRequest="34" HeightRequest="34"
                        BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}"
                        StrokeThickness="0" HorizontalOptions="Start" Margin="0,0,0,10">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="17"/>
                    </Border.StrokeShape>
                    <Image Source="ic_back.svg" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackClicked"/>
                    </Border.GestureRecognizers>
                </Border>

                <Border WidthRequest="90" HeightRequest="90" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}"
                        HorizontalOptions="Center" Margin="0,0,0,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="45"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.08" Offset="0,6" Radius="14"/>
                    </Border.Shadow>
                    <Image Source="registro.png" Aspect="AspectFill" WidthRequest="90" HeightRequest="90"/>
                </Border>

                <Label Text="Crear Cuenta" FontSize="22" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label Text="Únete a ArchiSpace" FontSize="13"
                       TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                       HorizontalOptions="Center" Margin="0,4,0,24"/>

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Entry x:Name="RegNombreEntry" Placeholder="Nombre"
                                   TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                   Margin="15,0" VerticalOptions="Center"/>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="16"/>
                            </Border.StrokeShape>
                            <Entry x:Name="RegApellidoEntry" Placeholder="Apellido"
                                   TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                   Margin="15,0" VerticalOptions="Center"/>
                        </Border>
                    </Grid>

                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="15,0">
                            <Image Source="nav_user.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Opacity="0.5"/>
                            <Entry Grid.Column="1" x:Name="RegEmailEntry" Placeholder="Correo Electrónico"
                                   TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                   Keyboard="Email" Margin="10,0,0,0" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,0">
                            <Image Source="nav_layers.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Opacity="0.5"/>
                            <Entry Grid.Column="1" x:Name="RegPasswordEntry" Placeholder="Contraseña"
                                   TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                   IsPassword="True" Margin="10,0,0,0" VerticalOptions="Center"/>
                            <Image Grid.Column="2" x:Name="RegPasswordToggleIcon" Source="ic_eye_off.svg"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Opacity="0.5" Margin="5,0">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleRegPasswordVisibility"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Picker x:Name="RegRolPicker" Title="¿Qué rol tienes?"
                                TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                TitleColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                Margin="15,0" VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Cliente</x:String>
                                    <x:String>Arquitecto</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>

                    <Button x:Name="BtnSubmitRegister" Text="Crear Cuenta"
                            BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}"
                            TextColor="#FFFFFF" HeightRequest="52" CornerRadius="16"
                            FontSize="16" FontAttributes="Bold" Clicked="OnSubmitRegisterClicked" Margin="0,4,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#0A4174" Opacity="0.25" Offset="0,6" Radius="12"/>
                        </Button.Shadow>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,8,0,0">
                        <Label Text="¿Ya tienes cuenta?" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="14" VerticalOptions="Center"/>
                        <Label Text="Inicia sesión" TextColor="#0A4174" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#0A4174" WidthRequest="50" HeightRequest="50"/>
                <Label x:Name="LoadingLabel" Text="Creando cuenta..." TextColor="#001D39" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
