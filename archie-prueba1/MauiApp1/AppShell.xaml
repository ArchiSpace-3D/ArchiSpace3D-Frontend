<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    Title="MauiApp1">

    <!-- Personalización de colores de la barra inferior y superior (quitando el morado) -->
    <Shell.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#92A38D</Color> <!-- Verde salvia (Reemplaza al morado) -->
            <Style TargetType="TabBar">
                <Setter Property="Shell.BackgroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.TitleColor" Value="#856C4E" />
                <Setter Property="Shell.UnselectedColor" Value="#E4C99D" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.TabBarTitleColor" Value="#92A38D" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#AC8A6E" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <Tab Title="Inicio" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" Route="DashboardPage" />
        </Tab>
        <Tab Title="Sensores" Icon="dotnet_bot.png">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
    </TabBar>

</Shell>
