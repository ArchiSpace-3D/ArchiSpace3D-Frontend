<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    Title="Archie">

    <Shell.Resources>
        <ResourceDictionary>
            <Color x:Key="Primary">#001D39</Color>
            <Style TargetType="TabBar">
                <Setter Property="Shell.BackgroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.ForegroundColor" Value="#001D39" />
                <Setter Property="Shell.TitleColor" Value="#001D39" />
                <Setter Property="Shell.UnselectedColor" Value="#6EA2B3" />
                <Setter Property="Shell.TabBarBackgroundColor" Value="#FFFFFF" />
                <Setter Property="Shell.TabBarTitleColor" Value="#001D39" />
                <Setter Property="Shell.TabBarUnselectedColor" Value="#6EA2B3" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <TabBar>
        <Tab Title="Inicio" Icon="nav_home.svg">
            <ShellContent ContentTemplate="{DataTemplate local:DashboardPage}" Route="DashboardPage" />
        </Tab>
        <Tab Title="Diseño" Icon="nav_layers.svg">
            <ShellContent ContentTemplate="{DataTemplate local:DesignPage}" Route="DesignPage" />
        </Tab>
        <Tab Title="Medición" Icon="nav_measure.svg">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Perfil" Icon="nav_user.svg">
            <ShellContent ContentTemplate="{DataTemplate local:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>

</Shell>
