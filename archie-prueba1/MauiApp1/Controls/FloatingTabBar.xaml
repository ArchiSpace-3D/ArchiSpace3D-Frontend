<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Controls.FloatingTabBar"
             VerticalOptions="End" HorizontalOptions="Center">

    <Border BackgroundColor="{AppThemeBinding Light=#F2FFFFFF, Dark=#F21C1C1E}"
            Stroke="{AppThemeBinding Light=#14000000, Dark=#2AFFFFFF}"
            StrokeThickness="1"
            Margin="20,0,20,20"
            HeightRequest="70"
            VerticalOptions="End"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="35" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="16" Opacity="0.18"/>
        </Border.Shadow>

        <HorizontalStackLayout Spacing="6" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Center">

            <!-- Tab 0: Inicio -->
            <Border x:Name="Bg0" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon0" Source="{AppThemeBinding Light=nav_home.svg, Dark=nav_home_white.svg}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 1: Planos / Diseño CAD -->
            <Border x:Name="Bg1" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon1" Source="{AppThemeBinding Light=nav_layers.svg, Dark=nav_layers_white.svg}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 2: Clientes / Arquitecto -->
            <Border x:Name="Bg2" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon2" Source="{AppThemeBinding Light=nav_clients.svg, Dark=nav_clients_white.svg}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 3: Mediciones AR -->
            <Border x:Name="Bg3" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon3" Source="{AppThemeBinding Light=nav_measure_dark.svg, Dark=nav_measure_white.svg}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 4: Perfil -->
            <Border x:Name="Bg4" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="4"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon4" Source="{AppThemeBinding Light=nav_user.svg, Dark=nav_user_white.svg}" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

        </HorizontalStackLayout>
    </Border>
</ContentView>
