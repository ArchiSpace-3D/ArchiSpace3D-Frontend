<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Controls.FloatingTabBar"
             VerticalOptions="End" HorizontalOptions="Center">

    <Border BackgroundColor="#F2FFFFFF"
            StrokeThickness="0"
            Margin="20,0,20,20"
            HeightRequest="70"
            VerticalOptions="End"
            HorizontalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="35" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="#000000" Offset="0,4" Radius="16" Opacity="0.12"/>
        </Border.Shadow>

        <HorizontalStackLayout Spacing="6" Padding="10,0" VerticalOptions="Center" HorizontalOptions="Center">

            <!-- Tab 0: Inicio -->
            <Border x:Name="Bg0" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="0"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon0" Source="nav_home.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 1: Proyectos / Diseño -->
            <Border x:Name="Bg1" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="1"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon1" Source="nav_layers.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 2: Enviar -->
            <Border x:Name="Bg2" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="2"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon2" Source="nav_send.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 3: Buscar -->
            <Border x:Name="Bg3" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="3"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon3" Source="nav_search.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <!-- Tab 4: Perfil -->
            <Border x:Name="Bg4" BackgroundColor="Transparent" StrokeThickness="0" HeightRequest="52" WidthRequest="52">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="26"/>
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabTapped" CommandParameter="4"/>
                </Border.GestureRecognizers>
                <Image x:Name="Icon4" Source="nav_user.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

        </HorizontalStackLayout>
    </Border>
</ContentView>