<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.MainPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F0F1EA">

    <ScrollView>
        <VerticalStackLayout Padding="20,50,20,40" Spacing="20">
            
            <VerticalStackLayout Spacing="5" Margin="0,0,0,10">
                <Label Text="Herramientas." 
                       FontSize="36" 
                       FontAttributes="Bold" 
                       TextColor="#856C4E" />
                <Label Text="Panel de control y sensores" 
                       FontSize="16" 
                       TextColor="#AC8A6E" />
            </VerticalStackLayout>

            <!-- Botón para entrar al módulo de AR -->
            <Button Clicked="OnEnterARClicked" 
                    Text="Entrar a Realidad Aumentada (3D)"
                    TextColor="#F0F1EA" 
                    CornerRadius="14" 
                    HeightRequest="60" 
                    FontSize="16"
                    FontAttributes="Bold">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#92A38D" Offset="0.0" />
                        <GradientStop Color="#856C4E" Offset="1.0" />
                    </LinearGradientBrush>
                </Button.Background>
            </Button>

            <!-- Grid de Sensores (Dashboard) -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="15" RowSpacing="15" Margin="0,10,0,0">
                
                <!-- Batería -->
                <Border Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" /></Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="🔋" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Batería" FontSize="15" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="BatteryLabel" Text="Calculando..." TextColor="#AC8A6E" FontSize="12" />
                        <Button Text="↻ Actualizar" Clicked="OnRefreshBatteryClicked" BackgroundColor="#F0F1EA" TextColor="#AC8A6E" CornerRadius="10" FontSize="12" HeightRequest="32" Padding="0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Acelerómetro -->
                <Border Grid.Row="0" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" /></Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="🚀" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Acelerómet." FontSize="15" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="AccelLabel" Text="Esperando..." TextColor="#AC8A6E" FontSize="12" />
                        <Button x:Name="BtnToggleAccel" Text="Activar" Clicked="OnToggleAccelClicked" BackgroundColor="#92A38D" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="32" FontSize="12" Padding="0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Giroscopio -->
                <Border Grid.Row="1" Grid.Column="0" BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" /></Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="🌀" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Giroscopio" FontSize="15" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="GyroLabel" Text="Esperando..." TextColor="#AC8A6E" FontSize="12" />
                        <Button x:Name="BtnToggleGyro" Text="Activar" Clicked="OnToggleGyroClicked" BackgroundColor="#92A38D" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="32" FontSize="12" Padding="0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Brújula -->
                <Border Grid.Row="1" Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" /></Border.Shadow>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="🧭" FontSize="20" VerticalOptions="Center"/>
                            <Label Text="Brújula" FontSize="15" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Label x:Name="CompassLabel" Text="Esperando..." TextColor="#AC8A6E" FontSize="12" />
                        <Button x:Name="BtnToggleCompass" Text="Activar" Clicked="OnToggleCompassClicked" BackgroundColor="#92A38D" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="32" FontSize="12" Padding="0"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Barómetro (Ahora en el grid) -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow><Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" /></Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="⛰️" FontSize="20" />
                                <Label Text="Barómetro" FontSize="15" FontAttributes="Bold" TextColor="#856C4E" />
                            </HorizontalStackLayout>
                            <Label x:Name="BarometerLabel" Text="Esperando datos..." TextColor="#AC8A6E" FontSize="12" />
                        </VerticalStackLayout>
                        <Button x:Name="BtnToggleBarometer" Grid.Column="1" Text="Activar" Clicked="OnToggleBarometerClicked" BackgroundColor="#92A38D" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="35" FontSize="12" VerticalOptions="Center"/>
                    </Grid>
                </Border>
            </Grid>
            
            <Label Text="Utilidades" 
                   FontSize="24" 
                   FontAttributes="Bold" 
                   TextColor="#856C4E"
                   Margin="0,20,0,0" />

            <!-- Telémetro Trigonométrico -->
            <Border BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="📐" FontSize="22" VerticalOptions="Center"/>
                        <Label Text="Telémetro" FontSize="18" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Usa la cámara y el acelerómetro para medir distancias reales." TextColor="#AC8A6E" FontSize="14" Margin="34,0,0,0"/>
                    
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Margin="34,5,0,0">
                        <Label Text="Tu altura (m):" TextColor="#856C4E" VerticalOptions="Center" FontSize="15"/>
                        <Border Padding="8,2" Stroke="#E4C99D" StrokeThickness="1" BackgroundColor="#F0F1EA">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="UserHeightEntry" Text="1.50" Keyboard="Numeric" TextColor="#856C4E" BackgroundColor="Transparent" WidthRequest="60" HorizontalTextAlignment="Center"/>
                        </Border>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="34,10,0,0">
                        <Button Grid.Column="0" Text="Base" Clicked="OnMarkBaseClicked" 
                                BackgroundColor="#F0F1EA" TextColor="#856C4E" CornerRadius="12" FontAttributes="Bold" HeightRequest="48"/>
                        <Button Grid.Column="1" Text="Tope" Clicked="OnMarkTopClicked" 
                                BackgroundColor="#F0F1EA" TextColor="#856C4E" CornerRadius="12" FontAttributes="Bold" HeightRequest="48"/>
                    </Grid>

                    <Label x:Name="TrigResultLabel" Text="Esperando mediciones..." TextColor="#856C4E" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="34,10,0,0"/>
                </VerticalStackLayout>
            </Border>
            
            <!-- Medición por Satélite (GPS) -->
            <Border BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="🛰️" FontSize="22" VerticalOptions="Center"/>
                        <Label Text="GPS Distancia" FontSize="18" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Mide grandes distancias al aire libre." TextColor="#AC8A6E" FontSize="14" Margin="34,0,0,0"/>
                    
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="34,10,0,0">
                        <Button Grid.Column="0" Text="Punto A" Clicked="OnGpsPointAClicked" 
                                BackgroundColor="#F0F1EA" TextColor="#856C4E" CornerRadius="12" FontAttributes="Bold" HeightRequest="48"/>
                        <Button Grid.Column="1" Text="Punto B" Clicked="OnGpsPointBClicked" 
                                BackgroundColor="#F0F1EA" TextColor="#856C4E" CornerRadius="12" FontAttributes="Bold" HeightRequest="48"/>
                    </Grid>
                    
                    <Label x:Name="GpsResultLabel" Text="Esperando puntos..." TextColor="#AC8A6E" FontSize="15" HorizontalTextAlignment="Center" Margin="34,10,0,0"/>
                </VerticalStackLayout>
            </Border>


            
            <!-- Foto-Medición por Referencia -->
            <Border BackgroundColor="#FFFFFF" Stroke="#E4C99D" StrokeThickness="1" Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20"/>
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#856C4E" Offset="0,8" Radius="15" Opacity="0.08" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="15">
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Label Text="📸" FontSize="22" VerticalOptions="Center"/>
                        <Label Text="Foto Referencia" FontSize="18" FontAttributes="Bold" TextColor="#856C4E" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="Toma una foto de un objeto junto a una tarjeta (8.5cm)." TextColor="#AC8A6E" FontSize="14" Margin="34,0,0,0"/>
                    
                    <Button Text="Tomar Foto" Clicked="OnTakePhotoForMeasureClicked" 
                            BackgroundColor="#92A38D" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" Margin="34,10,0,0"/>
                            
                    <Label x:Name="PhotoMeasureInstructionLabel" Text="" TextColor="#92A38D" FontSize="14" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="34,5,0,0"/>
                    
                    <Grid x:Name="ImageContainer" HeightRequest="300" IsVisible="False" Margin="34,10,0,0">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnImageTapped"/>
                        </Grid.GestureRecognizers>
                        <Image x:Name="CapturedImage" Aspect="AspectFit" />
                        <AbsoluteLayout x:Name="DotsLayout" BackgroundColor="Transparent" />
                    </Grid>
                    
                    <Label x:Name="PhotoMeasureResultLabel" Text="" TextColor="#856C4E" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="34,5,0,0"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="34,10,0,0">
                        <Button x:Name="BtnUndoPhotoMeasure" Grid.Column="0" Text="Deshacer" Clicked="OnUndoPhotoMeasureClicked" IsVisible="False"
                                BackgroundColor="#F0F1EA" TextColor="#856C4E" CornerRadius="12" HeightRequest="48" FontAttributes="Bold"/>
                        <Button x:Name="BtnResetPhotoMeasure" Grid.Column="1" Text="Reiniciar" Clicked="OnResetPhotoMeasureClicked" IsVisible="False"
                                BackgroundColor="#AC8A6E" TextColor="#FFFFFF" CornerRadius="12" HeightRequest="48" FontAttributes="Bold"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
