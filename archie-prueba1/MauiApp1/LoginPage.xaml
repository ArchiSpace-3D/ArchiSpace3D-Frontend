<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="30,70,30,30" HorizontalOptions="Center" MaximumWidthRequest="400">

                <Border WidthRequest="120" HeightRequest="120" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}"
                        HorizontalOptions="Center" Margin="0,0,0,20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="60"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.08" Offset="0,6" Radius="14"/>
                    </Border.Shadow>
<Label Text="Crear Cuenta" FontSize="26" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                        <Label Text="Únete a ArchiSpace" FontSize="15" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="34" HeightRequest="34" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" VerticalOptions="Start">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="17"/>
                        </Border.StrokeShape>
                        <Image Source="ic_close.svg" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCloseRegisterSheetClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Entry x:Name="RegNombreEntry" Placeholder="Nombre" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="15,0" VerticalOptions="Center"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>
                        <Entry x:Name="RegApellidoEntry" Placeholder="Apellido" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="15,0" VerticalOptions="Center"/>
                    </Border>
                </Grid>

<Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="55">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Entry x:Name="RegEmailEntry" Placeholder="Correo electrónico" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Keyboard="Email" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="RegPasswordEntry" Placeholder="Contraseña" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" IsPassword="True" Margin="15,0,0,0" VerticalOptions="Center"/>
                        <Image Grid.Column="1" x:Name="RegPasswordToggleIcon" Source="ic_eye_off.svg" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Opacity="0.5" Margin="5,0,15,0">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnToggleRegPasswordVisibility"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>
                </Border>

                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="55">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                    <Picker x:Name="RegRolPicker" Title="�¿Qué rol tienes?" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TitleColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="15,0" VerticalOptions="Center">                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Cliente</x:String>
                                <x:String>Arquitecto</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Border>

                <Button x:Name="BtnSubmitRegister" Text="Crear Cuenta"
                        BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}"
                        TextColor="#FFFFFF" HeightRequest="52" CornerRadius="16"
                        FontSize="15" FontAttributes="Bold" Clicked="OnSubmitRegisterClicked" Margin="0,8,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#0A4174" Opacity="0.25" Offset="0,6" Radius="12"/>
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </Border>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#0A4174" WidthRequest="50" HeightRequest="50"/>
                <Label x:Name="LoadingLabel" Text="Conectando..." TextColor="#001D39" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

        <Border x:Name="AppleToast" BackgroundColor="#001D39" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,50,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold"/>
        </Border>
    </Grid>
</ContentPage>