<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid x:Name="RootGrid">
        <!-- Background Image -->
        <Image x:Name="BgImage" Source="bg_login.jpg" Aspect="AspectFill" VerticalOptions="Fill" HorizontalOptions="Fill" Opacity="0.85"/>
        
        <!-- Glass/White Form Card -->
        <Border x:Name="FormCard" BackgroundColor="{AppThemeBinding Light=#EEFFFFFF, Dark=#EE121212}" 
                Stroke="{AppThemeBinding Light=#FFFFFF, Dark=#333333}" StrokeThickness="1" 
                VerticalOptions="Center" HorizontalOptions="Fill" Margin="24,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="30"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="#000000" Opacity="0.15" Offset="0,10" Radius="20"/>
            </Border.Shadow>

            <ScrollView>
                <VerticalStackLayout x:Name="MainLayout" Spacing="20" Padding="30,40" MaximumWidthRequest="400" HorizontalOptions="Center">
                    
                    <Label Text="Log in" FontSize="28" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                    
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Login, email or phone number" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                            <Entry x:Name="EmailEntry" Keyboard="Email" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="20,0" VerticalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Password" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <Border Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent" HeightRequest="50">
                            <Border.StrokeShape><RoundRectangle CornerRadius="25"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" Padding="20,0,15,0">
                                <Entry x:Name="PasswordEntry" IsPassword="True" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" VerticalOptions="Center"/>
                                <Image Grid.Column="1" x:Name="PasswordToggleIcon" Source="ic_eye_off.svg" WidthRequest="20" HeightRequest="20" Opacity="0.5" VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTogglePasswordVisibility"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="LoginButton" Text="Log in" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}" TextColor="#FFFFFF" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnLoginClicked" Margin="0,10,0,0">
                        <Button.Shadow>
                            <Shadow Brush="#0A4174" Opacity="0.3" Offset="0,5" Radius="10"/>
                        </Button.Shadow>
                    </Button>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,10" VerticalOptions="Center">
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="or log in with" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" VerticalOptions="Center"/>
                        <BoxView Grid.Column="2" HeightRequest="1" Color="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" VerticalOptions="Center"/>
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Border x:Name="GoogleLoginButton" WidthRequest="50" HeightRequest="50" Stroke="{AppThemeBinding Light=#BDD8E9, Dark=#333333}" StrokeThickness="1" BackgroundColor="Transparent">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Image Source="ic_google.svg" WidthRequest="24" HeightRequest="24" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoogleLoginClicked"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>

                    <Label Text="Forgot login or password?" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" HorizontalOptions="Center" Margin="0,15,0,0"/>
                    
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,15,0,0">
                        <Label Text="Don't have an account?" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="13" VerticalOptions="Center"/>
                        <Label Text="Register" TextColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnOpenRegisterSheetClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark=#CC000000}" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" WidthRequest="50" HeightRequest="50"/>
                <Label x:Name="LoadingLabel" Text="Connecting..." TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" Margin="20,0"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Toast -->
        <Border x:Name="AppleToast" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,50,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" FontSize="14" FontAttributes="Bold"/>
        </Border>
    </Grid>
</ContentPage>
