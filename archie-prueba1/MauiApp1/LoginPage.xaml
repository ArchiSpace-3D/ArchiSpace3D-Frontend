<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">

    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0" Padding="24,20,24,20"
                                  HorizontalOptions="Center" VerticalOptions="Center"
                                  MaximumWidthRequest="400">

                <Border WidthRequest="90" HeightRequest="90" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}"
                        HorizontalOptions="Center" Margin="0,0,0,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="45"/>
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.08" Offset="0,6" Radius="14"/>
                    </Border.Shadow>
                    <Image Source="arqui.png" Aspect="AspectFill" WidthRequest="90" HeightRequest="90"/>
                </Border>

                <Label Text="Bienvenido a ArchiSpace" FontSize="22" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label Text="Inicia sesión para ver tus modelos" FontSize="13"
                       TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                       HorizontalOptions="Center" Margin="0,4,0,24"/>

                <VerticalStackLayout Spacing="12">

                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*" Padding="15,0">
                            <Image Source="nav_user.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Opacity="0.5"/>
                            <Entry Grid.Column="1" x:Name="EmailEntry" Placeholder="Correo electrónico"
                                   PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                   TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   Keyboard="Email" Margin="10,0,0,0" VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="52">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="Auto,*,Auto" Padding="15,0">
                            <Image Source="nav_layers.svg" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" Opacity="0.5"/>
                            <Entry Grid.Column="1" x:Name="PasswordEntry" Placeholder="Contraseña"
                                   PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"
                                   TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   IsPassword="True" Margin="10,0,0,0" VerticalOptions="Center"/>
                            <Image Grid.Column="2" x:Name="PasswordToggleIcon" Source="ic_eye_off.svg"
                                   WidthRequest="22" HeightRequest="22" VerticalOptions="Center" Opacity="0.5" Margin="5,0">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnTogglePasswordVisibility"/>
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                    </Border>

                    <Label Text="¿Olvidaste tu contraseña?" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}"
                           FontSize="13" FontAttributes="Bold" HorizontalOptions="End" Margin="0,-2,0,2"/>

                    <Button x:Name="LoginButton" Text="Iniciar Sesión"
                            BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#13558F}"
                            TextColor="#FFFFFF" HeightRequest="52" CornerRadius="16"
                            FontSize="16" FontAttributes="Bold" Clicked="OnLoginClicked">
                        <Button.Shadow>
                            <Shadow Brush="#0A4174" Opacity="0.25" Offset="0,6" Radius="12"/>
                        </Button.Shadow>
                    </Button>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="12" Margin="0,8,0,0" VerticalOptions="Center">
                        <BoxView Color="{AppThemeBinding Light=#DCE4EA, Dark=#333333}" HeightRequest="1"/>
                        <Label Grid.Column="1" Text="O" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <BoxView Grid.Column="2" Color="{AppThemeBinding Light=#DCE4EA, Dark=#333333}" HeightRequest="1"/>
                    </Grid>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,2,0,0">
                        <Border x:Name="GoogleLoginBorder" WidthRequest="48" HeightRequest="48"
                                Stroke="{AppThemeBinding Light=#DCE4EA, Dark=#333333}" StrokeThickness="1.5"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Label Text="G" FontSize="18" FontAttributes="Bold" TextColor="#0A4174"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoogleLoginClicked"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border WidthRequest="48" HeightRequest="48"
                                Stroke="{AppThemeBinding Light=#DCE4EA, Dark=#333333}" StrokeThickness="1.5"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Label Text="" FontSize="20" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAppleLoginClicked"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Border WidthRequest="48" HeightRequest="48"
                                Stroke="{AppThemeBinding Light=#DCE4EA, Dark=#333333}" StrokeThickness="1.5"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24"/>
                            </Border.StrokeShape>
                            <Label Text="f" FontSize="20" FontAttributes="Bold" TextColor="#49769F"
                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFacebookLoginClicked"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,8,0,0">
                        <Label Text="¿No tienes cuenta?" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="14" VerticalOptions="Center"/>
                        <Label Text="Regístrate" TextColor="#0A4174" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnGoToRegisterClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="LoadingOverlay" BackgroundColor="#CCFFFFFF" IsVisible="False">
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" Color="#0A4174" WidthRequest="50" HeightRequest="50"/>
                <Label x:Name="LoadingLabel" Text="Conectando..." TextColor="#001D39" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Grid>

        <Border x:Name="AppleToast" BackgroundColor="#001D39" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,50,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold"/>
        </Border>
    </Grid>
</ContentPage>
