<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.LoginPage"
             BackgroundColor="#DCD7C9"
             NavigationPage.HasNavigationBar="False">

    <Grid>
        <!-- Fondo Superior con Gradiente de la paleta (Inkwell -> Lunar Eclipse) -->
        <Border StrokeThickness="0" VerticalOptions="Start" HeightRequest="450" Margin="0,-50,0,0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#2C3639" Offset="0.0" /> <!-- Inkwell -->
                    <GradientStop Color="#3F4E4F" Offset="1.0" /> <!-- Lunar Eclipse -->
                </LinearGradientBrush>
            </Border.Background>
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="0,0,40,40" />
            </Border.StrokeShape>

            <VerticalStackLayout x:Name="HeaderBlock" Padding="30,120,30,0" Spacing="5">
                <Label Text="ArchiSpace." 
                       FontSize="42" 
                       FontAttributes="Bold" 
                       TextColor="#DCD7C9" /> <!-- Au Lait -->
                <Label Text="Visualización 3D" 
                       FontSize="34" 
                       TextColor="#A27B5B" /> <!-- Creme Brulee -->
            </VerticalStackLayout>
        </Border>

        <!-- Tarjeta Flotante -->
        <ScrollView VerticalOptions="End" Margin="0,250,0,0">
            <Border x:Name="LoginCard"
                    BackgroundColor="#FFFFFF" 
                    StrokeThickness="0"
                    Margin="20,0,20,30"
                    Padding="25,35,25,30">
                <Border.Shadow>
                    <Shadow Brush="#2C3639" Offset="0,15" Radius="30" Opacity="0.18" />
                </Border.Shadow>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="25" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="20">
                    
                    <Label Text="¡Bienvenido! Inicia sesión para ver tus modelos"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="#2C3639"
                           Margin="0,0,0,10"/>

                    <!-- Campo IP -->
                    <VerticalStackLayout Spacing="6">
                        <Border Stroke="#DCD7C9" StrokeThickness="1.5" BackgroundColor="#FFFFFF" Padding="15,5">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Entry x:Name="IpEntry" 
                                   Placeholder="Host / IP (ej. 192.168.101.75 o 10.0.2.2)" 
                                   Text=""
                                   Keyboard="Url"
                                   BackgroundColor="Transparent"
                                   PlaceholderColor="#7A8485"
                                   TextColor="#2C3639" />
                        </Border>
                        <!-- Accesos rapidos de IP -->
                        <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                            <Button Text="Mi PC (192.168.101.75)" 
                                    FontSize="11" 
                                    HeightRequest="30" 
                                    Padding="10,0"
                                    Margin="4,2"
                                    BackgroundColor="#A27B5B" 
                                    TextColor="#FFFFFF" 
                                    CornerRadius="8"
                                    Clicked="OnUseMyPcIpClicked"/>
                            <Button Text="Emulador (10.0.2.2)" 
                                    FontSize="11" 
                                    HeightRequest="30" 
                                    Padding="10,0"
                                    Margin="4,2"
                                    BackgroundColor="#3F4E4F" 
                                    TextColor="#DCD7C9" 
                                    CornerRadius="8"
                                    Clicked="OnUseEmulatorIpClicked"/>
                            <Button Text="Localhost" 
                                    FontSize="11" 
                                    HeightRequest="30" 
                                    Padding="10,0"
                                    Margin="4,2"
                                    BackgroundColor="#3F4E4F" 
                                    TextColor="#DCD7C9" 
                                    CornerRadius="8"
                                    Clicked="OnUseLocalhostClicked"/>
                        </FlexLayout>
                    </VerticalStackLayout>

                    <!-- Campo Correo -->
                    <Border Stroke="#DCD7C9" StrokeThickness="1.5" BackgroundColor="#FFFFFF" Padding="15,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="EmailEntry" 
                               Placeholder="Correo electrónico" 
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#7A8485"
                               TextColor="#2C3639" />
                    </Border>

                    <!-- Campo Contrasena -->
                    <Border Stroke="#DCD7C9" StrokeThickness="1.5" BackgroundColor="#FFFFFF" Padding="15,5">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12"/>
                        </Border.StrokeShape>
                        <Entry x:Name="PasswordEntry" 
                               Placeholder="Contraseña" 
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               PlaceholderColor="#7A8485"
                               TextColor="#2C3639" />
                    </Border>

                    <!-- Boton Principal -->
                    <Button x:Name="LoginButton"
                            Text="Iniciar Sesión"
                            TextColor="#FFFFFF"
                            CornerRadius="14"
                            HeightRequest="54"
                            FontSize="16"
                            FontAttributes="Bold"
                            Clicked="OnLoginClicked" 
                            Margin="0,10,0,5">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#A27B5B" Offset="0.0" />
                                <GradientStop Color="#3F4E4F" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                        <Label Text="¿No tienes cuenta?" TextColor="#3F4E4F" FontSize="13" VerticalOptions="Center" />
                        <Label Text="Regístrate" 
                               TextColor="#A27B5B" 
                               FontSize="13" 
                               FontAttributes="Bold" 
                               TextDecorations="Underline" 
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>

                    <Label Text="Entrar sin cuenta (Modo Offline)"
                           TextColor="#3F4E4F"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextDecorations="Underline"
                           HorizontalOptions="Center"
                           Margin="0,5,0,0">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSkipClicked" />
                        </Label.GestureRecognizers>
                    </Label>

                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- ==================== APPLE BOTTOM SHEET: REGISTRO ELEGANTE ==================== -->
        <Grid x:Name="RegisterSheetModal" IsVisible="False" InputTransparent="False">
            <BoxView BackgroundColor="#99000000" Opacity="0" x:Name="RegisterBackdrop">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseRegisterSheetClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="RegisterSheetCard" VerticalOptions="End" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="24,14,24,30">
                <Border.StrokeShape><RoundRectangle CornerRadius="28,28,0,0" /></Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <BoxView WidthRequest="36" HeightRequest="5" CornerRadius="2.5" Color="#DCD7C9" HorizontalOptions="Center"/>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Crear Cuenta" FontSize="20" FontAttributes="Bold" TextColor="#2C3639"/>
                            <Label Text="Únete a la plataforma arquitectónica" FontSize="12" TextColor="#7A8485"/>
                        </VerticalStackLayout>
                        <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="22" HeightRequest="22">
                            <Image.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCloseRegisterSheetClicked"/>
                            </Image.GestureRecognizers>
                        </Image>
                    </Grid>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Entry x:Name="RegNombreEntry" Placeholder="Nombre" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                        <Entry Grid.Column="1" x:Name="RegApellidoEntry" Placeholder="Apellido" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                    </Grid>

                    <Entry x:Name="RegEmailEntry" Placeholder="Correo Electrónico" Keyboard="Email" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>
                    <Entry x:Name="RegPasswordEntry" Placeholder="Contraseña" IsPassword="True" BackgroundColor="#F5F3EF" TextColor="#2C3639" HeightRequest="46"/>

                    <Label Text="Selecciona tu Rol:" FontSize="13" FontAttributes="Bold" TextColor="#2C3639" Margin="0,4,0,0"/>
                    <Picker x:Name="RegRolPicker" BackgroundColor="#F5F3EF" TextColor="#2C3639" SelectedIndex="0">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Arquitecto</x:String>
                                <x:String>Cliente</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Button Text="Registrar Cuenta" BackgroundColor="#A27B5B" TextColor="#FFFFFF"
                            CornerRadius="16" HeightRequest="52" FontAttributes="Bold" FontSize="15"
                            Clicked="OnSubmitRegisterClicked" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- ==================== APPLE TOAST ==================== -->
        <Border x:Name="AppleToast" VerticalOptions="Start" HorizontalOptions="Center" Margin="0,50,0,0"
                BackgroundColor="#2C3639" Stroke="#A27B5B" StrokeThickness="1" Padding="20,12" IsVisible="False" Opacity="0">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Border.Shadow><Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.2"/></Border.Shadow>
            <Label x:Name="AppleToastMessage" Text="" FontSize="14" FontAttributes="Bold" TextColor="#DCD7C9" HorizontalTextAlignment="Center"/>
        </Border>

    </Grid>
</ContentPage>
