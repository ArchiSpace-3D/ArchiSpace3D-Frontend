<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.LoginPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FFFFFF">

    <Grid>
        <!-- Custom Top Wave Header imitating the peach design but in blue -->
        <Path Data="M 0,0 L 400,0 L 400,160 C 250,260 100,100 0,220 Z" 
              Fill="#0A4174" Opacity="0.9" 
              HorizontalOptions="Fill" VerticalOptions="Start" />
        <Path Data="M 0,0 L 400,0 L 400,120 C 300,180 150,80 0,160 Z" 
              Fill="#7BBDE8" Opacity="0.7" 
              HorizontalOptions="Fill" VerticalOptions="Start" />

        <ScrollView Margin="0,200,0,0">
            <VerticalStackLayout Spacing="0" Padding="30,20,30,30" HorizontalOptions="Center" MaximumWidthRequest="400">
                
                <!-- Sign In Header Area -->
                <Label Text="Sign In" FontSize="28" FontAttributes="Bold" TextColor="#001D39"/>
                <Label Text="Sign in to your Registered Account." FontSize="12" TextColor="#6EA2B3" Margin="0,2,0,0"/>
                <BoxView Color="#49769F" HeightRequest="3" WidthRequest="25" HorizontalOptions="Start" Margin="0,8,0,40" CornerRadius="1.5"/>

                <VerticalStackLayout Spacing="25">
                    
                    <!-- Email Input with bottom line -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Email Address" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                        <Entry x:Name="EmailEntry" Placeholder="tu@email.com" PlaceholderColor="#BDD8E9" TextColor="#001D39" Keyboard="Email" BackgroundColor="Transparent"/>
                        <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                    </VerticalStackLayout>

                    <!-- Password Input with bottom line -->
                    <VerticalStackLayout Spacing="0">
                        <Label Text="Password" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry x:Name="PasswordEntry" Placeholder="••••••••" PlaceholderColor="#BDD8E9" TextColor="#001D39" IsPassword="True" BackgroundColor="Transparent"/>
                            <Image Grid.Column="1" Source="ic_eye.svg" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="0.5"/>
                        </Grid>
                        <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                    </VerticalStackLayout>
                    
                    <Label Text="Forgot Password?" TextColor="#49769F" FontSize="11" FontAttributes="Bold" HorizontalOptions="End" Margin="0,-10,0,30"/>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="15" HorizontalOptions="Center">
                        <Border BackgroundColor="#FFFFFF" Stroke="#49769F" StrokeThickness="1" HeightRequest="40" WidthRequest="100">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <Label Text="SIGN UP" TextColor="#49769F" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenRegisterSheetClicked"/></Border.GestureRecognizers>
                        </Border>
                        
                        <Border Grid.Column="1" BackgroundColor="#49769F" StrokeThickness="0" HeightRequest="40" WidthRequest="100">
                            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#49769F" Opacity="0.5" Offset="0,4" Radius="8"/></Border.Shadow>
                            <Label Text="SIGN IN" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnLoginClicked"/></Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Register Sheet (Sign Up) -->
        <BoxView x:Name="RegisterBackdrop" BackgroundColor="#CCFFFFFF" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseRegisterSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>

        <Grid x:Name="RegisterSheetCard" BackgroundColor="#FFFFFF" VerticalOptions="End" TranslationY="1200">
            <!-- Simulated Wave inside the modal -->
            <Path Data="M 0,0 L 400,0 L 400,80 C 250,150 100,50 0,100 Z" Fill="#0A4174" Opacity="0.9" HorizontalOptions="Fill" VerticalOptions="Start" />
            <Path Data="M 0,0 L 400,0 L 400,50 C 300,100 150,20 0,80 Z" Fill="#7BBDE8" Opacity="0.7" HorizontalOptions="Fill" VerticalOptions="Start" />

            <ScrollView Margin="0,80,0,0">
                <VerticalStackLayout Spacing="0" Padding="30,20,30,40">
                    
                    <Label Text="Sign Up" FontSize="28" FontAttributes="Bold" TextColor="#001D39"/>
                    <Label Text="Register with your valid email address" FontSize="12" TextColor="#6EA2B3" Margin="0,2,0,0"/>
                    <BoxView Color="#49769F" HeightRequest="3" WidthRequest="25" HorizontalOptions="Start" Margin="0,8,0,30" CornerRadius="1.5"/>

                    <VerticalStackLayout Spacing="20">
                        <!-- Nombre -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="First Name" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Entry x:Name="RegNombreEntry" Placeholder="John" PlaceholderColor="#BDD8E9" TextColor="#001D39" BackgroundColor="Transparent"/>
                            <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                        </VerticalStackLayout>
                        
                        <!-- Apellido -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Last Name" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Entry x:Name="RegApellidoEntry" Placeholder="Doe" PlaceholderColor="#BDD8E9" TextColor="#001D39" BackgroundColor="Transparent"/>
                            <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                        </VerticalStackLayout>

                        <!-- Email -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Email Address" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Entry x:Name="RegEmailEntry" Placeholder="john@gmail.com" PlaceholderColor="#BDD8E9" TextColor="#001D39" Keyboard="Email" BackgroundColor="Transparent"/>
                            <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                        </VerticalStackLayout>

                        <!-- Password -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Password" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Entry x:Name="RegPasswordEntry" Placeholder="••••••••" PlaceholderColor="#BDD8E9" TextColor="#001D39" IsPassword="True" BackgroundColor="Transparent"/>
                            <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                        </VerticalStackLayout>

                        <!-- Rol -->
                        <VerticalStackLayout Spacing="0">
                            <Label Text="Role" FontSize="11" TextColor="#6EA2B3" FontAttributes="Bold" Margin="0,0,0,5"/>
                            <Picker x:Name="RegRolPicker" Title="Select Role" TextColor="#001D39" TitleColor="#BDD8E9" BackgroundColor="Transparent">
                                <Picker.ItemsSource>
                                    <x:Array Type="{x:Type x:String}">
                                        <x:String>Cliente</x:String>
                                        <x:String>Arquitecto</x:String>
                                    </x:Array>
                                </Picker.ItemsSource>
                            </Picker>
                            <BoxView Color="#E8F1F8" HeightRequest="2" Margin="0,5,0,0"/>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="15" HorizontalOptions="Center" Margin="0,20,0,0">
                            <Border x:Name="BtnSubmitRegister" BackgroundColor="#49769F" StrokeThickness="0" HeightRequest="40" WidthRequest="100">
                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                <Border.Shadow><Shadow Brush="#49769F" Opacity="0.5" Offset="0,4" Radius="8"/></Border.Shadow>
                                <Label Text="SIGN UP" TextColor="#FFFFFF" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSubmitRegisterClicked"/></Border.GestureRecognizers>
                            </Border>
                            
                            <Border Grid.Column="1" BackgroundColor="#FFFFFF" Stroke="#49769F" StrokeThickness="1" HeightRequest="40" WidthRequest="100">
                                <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                <Label Text="SIGN IN" TextColor="#49769F" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"/>
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseRegisterSheetClicked"/></Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" BackgroundColor="#99FFFFFF" IsVisible="False">
            <ActivityIndicator IsRunning="True" Color="#0A4174" WidthRequest="50" HeightRequest="50" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Grid>
        
        <!-- Toast -->
        <Border x:Name="AppleToast" BackgroundColor="#001D39" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold"/>
        </Border>
    </Grid>
</ContentPage>
