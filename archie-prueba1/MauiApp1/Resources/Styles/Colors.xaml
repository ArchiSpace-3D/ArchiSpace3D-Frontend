<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">


    <Color x:Key="Inkwell">#001D39</Color>
    <Color x:Key="LunarEclipse">#0A4174</Color>
    <Color x:Key="CremeBrulee">#49769F</Color>
    <Color x:Key="AuLait">#BDD8E9</Color>

    <Color x:Key="Primary">#49769F</Color>
    <Color x:Key="PrimaryDark">#001D39</Color>
    <Color x:Key="PrimaryDarkText">#BDD8E9</Color>
    <Color x:Key="Secondary">#0A4174</Color>
    <Color x:Key="SecondaryDarkText">#49769F</Color>
    <Color x:Key="Tertiary">#001D39</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">#1A1A1A</Color>
    <Color x:Key="Magenta">#49769F</Color>
    <Color x:Key="MidnightBlue">#001D39</Color>
    <Color x:Key="OffBlack">#001D39</Color>

    <Color x:Key="Gray100">#E8F1F8</Color>
    <Color x:Key="Gray200">#BDD8E9</Color>
    <Color x:Key="Gray300">#7BBDE8</Color>
    <Color x:Key="Gray400">#49769F</Color>
    <Color x:Key="Gray500">#5C6566</Color>
    <Color x:Key="Gray600">#0A4174</Color>
    <Color x:Key="Gray900">#001D39</Color>
    <Color x:Key="Gray950">#1E2527</Color>

    <SolidColorBrush x:Key="InkwellBrush" Color="{StaticResource Inkwell}"/>
    <SolidColorBrush x:Key="LunarEclipseBrush" Color="{StaticResource LunarEclipse}"/>
    <SolidColorBrush x:Key="CremeBruleeBrush" Color="{StaticResource CremeBrulee}"/>
    <SolidColorBrush x:Key="AuLaitBrush" Color="{StaticResource AuLait}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>


