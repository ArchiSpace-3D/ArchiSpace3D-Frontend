<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DashboardPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F4F6F8">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Spacing="25" Padding="20,40,20,20">
                
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="Hola," FontSize="16" TextColor="#6EA2B3"/>
                        <Label x:Name="NombreUsuarioLabel" Text="Usuario" FontSize="26" FontAttributes="Bold" TextColor="#001D39"/>
                    </VerticalStackLayout>
                    
                    <Border Grid.Column="1" WidthRequest="40" HeightRequest="40" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#001D39" Opacity="0.1" Offset="0,2" Radius="5"/>
                        </Border.Shadow>
                        <Image Source="ic_bell.svg" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnNotificationsClicked"/>
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Proyecto Activo -->
                <Border x:Name="ActiveProjectCard" BackgroundColor="#001D39" StrokeThickness="0" Padding="20">
                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#001D39" Opacity="0.2" Offset="0,4" Radius="10"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Proyecto Activo" FontSize="12" TextColor="#BDD8E9"/>
                            <Border Grid.Column="1" BackgroundColor="#0A4174" StrokeThickness="0" Padding="8,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                <Label x:Name="LblEstadoProyectoActivo" Text="Ninguno" FontSize="10" TextColor="#FFFFFF" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                        
                        <Label x:Name="LblNombreProyectoActivo" Text="Selecciona un proyecto" FontSize="22" FontAttributes="Bold" TextColor="#FFFFFF"/>
                        <Label x:Name="LblUbicacionProyectoActivo" Text="--" FontSize="14" TextColor="#7BBDE8" Margin="0,0,0,10"/>
                        
                        <Button Text="Ver Detalles" BackgroundColor="#FFFFFF" TextColor="#001D39" HeightRequest="40" CornerRadius="20" FontAttributes="Bold" Clicked="OnActiveProjectDetailsClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Acciones Rápidas -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,10">
                    <Border BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="10,15">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#001D39" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="ic_plus.svg" WidthRequest="24" HeightRequest="24"/>
                            <Label Text="Crear" FontSize="12" TextColor="#001D39" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenNewProjectSheetClicked"/></Border.GestureRecognizers>
                    </Border>
                    
                    <Border Grid.Column="1" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="10,15">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#001D39" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="ic_join.svg" WidthRequest="24" HeightRequest="24"/>
                            <Label Text="Unirse" FontSize="12" TextColor="#001D39" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenJoinCodeSheetClicked"/></Border.GestureRecognizers>
                    </Border>
                    
                    <Border Grid.Column="2" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="10,15">
                        <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                        <Border.Shadow><Shadow Brush="#001D39" Opacity="0.05" Offset="0,2" Radius="5"/></Border.Shadow>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="ic_ruler.svg" WidthRequest="24" HeightRequest="24"/>
                            <Label Text="Regla AR" FontSize="12" TextColor="#001D39" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReglaARClicked"/></Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Mis Proyectos -->
                <VerticalStackLayout x:Name="ProjectsSection" Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mis Proyectos" FontSize="18" FontAttributes="Bold" TextColor="#001D39" VerticalOptions="Center"/>
                        <Border Grid.Column="1" x:Name="RefreshBorder" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="32" HeightRequest="32">
                            <Image Source="ic_refresh.svg" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRefreshClicked"/></Border.GestureRecognizers>
                        </Border>
                    </Grid>
                    
                    <ActivityIndicator x:Name="LoadingProjectsIndicator" IsRunning="False" IsVisible="False" Color="#001D39" HorizontalOptions="Center" Margin="0,20"/>
                    
                    <CollectionView x:Name="ProjectsCollectionView">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" WidthRequest="240">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="16"/></Border.StrokeShape>
                                    <Border.Shadow><Shadow Brush="#001D39" Opacity="0.05" Offset="0,2" Radius="6"/></Border.Shadow>
                                    <Grid RowDefinitions="*,Auto" Padding="15">
                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="{Binding Nombre}" FontSize="16" FontAttributes="Bold" TextColor="#001D39"/>
                                            <Label Text="{Binding Ubicacion}" FontSize="12" TextColor="#6EA2B3"/>
                                            <Border BackgroundColor="#E8F1F8" StrokeThickness="0" HorizontalOptions="Start" Padding="8,4" Margin="0,5,0,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="8"/></Border.StrokeShape>
                                                <Label Text="{Binding Estado}" FontSize="10" TextColor="#0A4174" FontAttributes="Bold"/>
                                            </Border>
                                        </VerticalStackLayout>
                                        <Button Grid.Row="1" Text="Seleccionar" BackgroundColor="#F4F6F8" TextColor="#001D39" HeightRequest="36" CornerRadius="18" FontSize="12" FontAttributes="Bold" Margin="0,10,0,0" CommandParameter="{Binding .}" Clicked="OnSelectProjectClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                                <Label Text="Aún no tienes proyectos" TextColor="#0A4174" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Toca 'Crear' o 'Unirse'" TextColor="#6EA2B3" FontSize="13" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- Avisos Recientes -->
                <VerticalStackLayout x:Name="NotificationsSection" Spacing="15">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Avisos Recientes" FontSize="18" FontAttributes="Bold" TextColor="#001D39" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="#E8F1F8" StrokeThickness="0" Padding="10,4">
                            <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                            <Label x:Name="NotificationCountBadge" Text="0 nuevas" FontSize="11" FontAttributes="Bold" TextColor="#0A4174" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="NotificationsContainer" Spacing="10">
                        <!-- Llenado dinámicamente -->
                    </VerticalStackLayout>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Sheets -->
        <!-- Project Details Sheet -->
        <BoxView x:Name="DetailsBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseDetailsSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="ProjectDetailsSheetModal" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="DetailsSheetCard" Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="#BDD8E9" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label x:Name="SheetProjectName" Text="Nombre Proyecto" FontSize="22" FontAttributes="Bold" TextColor="#001D39"/>
                        <Label x:Name="SheetProjectCode" Text="Código: --" FontSize="12" TextColor="#6EA2B3"/>
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseDetailsSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="SheetProjectDesc" Text="Sin descripción" FontSize="14" TextColor="#001D39"/>
                        <Label x:Name="SheetProjectUbicacion" Text="Ubicación: --" FontSize="13" TextColor="#6EA2B3"/>
                        <Label x:Name="SheetProjectEstado" Text="Estado: --" FontSize="13" TextColor="#6EA2B3" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Activar" BackgroundColor="#001D39" TextColor="#FFFFFF" HeightRequest="48" CornerRadius="24" FontAttributes="Bold" Clicked="OnSetAsActiveProjectClicked"/>
                    <Button Grid.Column="1" Text="Diseño 3D" BackgroundColor="#F4F6F8" TextColor="#001D39" HeightRequest="48" CornerRadius="24" FontAttributes="Bold" Clicked="OnEnterDesignClicked"/>
                </Grid>
                <Button x:Name="BtnSheetEditarProyecto" Text="Editar Proyecto" BackgroundColor="Transparent" TextColor="#0A4174" HeightRequest="48" FontAttributes="Bold" Clicked="OnEditarProyectoFromDetailsClicked"/>
                <Button x:Name="BtnSheetEliminarProyecto" Text="Eliminar Proyecto" BackgroundColor="#FFF0F0" TextColor="#D32F2F" CornerRadius="24" HeightRequest="48" FontAttributes="Bold" Clicked="OnEliminarProyectoFromDetailsClicked"/>
            </VerticalStackLayout>
        </Border>

        <!-- New Project Sheet -->
        <BoxView x:Name="NewProjectBackdrop" BackgroundColor="#99000000" Opacity="0" InputTransparent="True">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="NewProjectSheetCard" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="End" TranslationY="600">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="#BDD8E9" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nuevo Proyecto" FontSize="22" FontAttributes="Bold" TextColor="#001D39"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryNombreProyecto" Placeholder="Nombre del proyecto" PlaceholderColor="#6EA2B3" TextColor="#001D39" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryUbicacionProyecto" Placeholder="Ubicación / Ciudad" PlaceholderColor="#6EA2B3" TextColor="#001D39" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Crear Proyecto" BackgroundColor="#001D39" TextColor="#FFFFFF" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitCrearProyectoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Edit Project Sheet -->
        <BoxView x:Name="EditProjectBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditProjectSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="EditProjectSheetModal" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="EditProjectSheetCard" Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="#BDD8E9" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Editar Proyecto" FontSize="22" FontAttributes="Bold" TextColor="#001D39"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditProjectSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditNombreProyecto" Placeholder="Nombre" PlaceholderColor="#6EA2B3" TextColor="#001D39" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditDescripcionProyecto" Placeholder="Descripción" PlaceholderColor="#6EA2B3" TextColor="#001D39" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditUbicacionProyecto" Placeholder="Ubicación" PlaceholderColor="#6EA2B3" TextColor="#001D39" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditPresupuestoProyecto" Placeholder="Presupuesto" Keyboard="Numeric" PlaceholderColor="#6EA2B3" TextColor="#001D39" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Guardar Cambios" BackgroundColor="#001D39" TextColor="#FFFFFF" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitEditarProyectoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Join Code Sheet -->
        <BoxView x:Name="JoinCodeBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseJoinCodeSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="JoinCodeSheetModal" BackgroundColor="#FFFFFF" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="JoinCodeSheetCard" Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="#BDD8E9" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Unirse con Código" FontSize="22" FontAttributes="Bold" TextColor="#001D39"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseJoinCodeSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Label Text="Ingresa el código proporcionado por el arquitecto para tener acceso al proyecto." FontSize="14" TextColor="#6EA2B3"/>
                <Border BackgroundColor="#F4F6F8" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryJoinCode" Placeholder="EJ: ARCHI-A1B2C3" PlaceholderColor="#6EA2B3" TextColor="#001D39" TextTransform="Uppercase" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Vincular Proyecto" BackgroundColor="#0A4174" TextColor="#FFFFFF" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitJoinCodeClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Toast -->
        <Border x:Name="AppleToast" BackgroundColor="#001D39" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="#FFFFFF" FontSize="14" FontAttributes="Bold"/>
        </Border>
    </Grid>
</ContentPage>
