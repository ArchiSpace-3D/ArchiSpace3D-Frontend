<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.DashboardPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}">

    <Grid>
        <!-- Blue Header Background -->
        <BoxView HeightRequest="280" VerticalOptions="Start" Color="{AppThemeBinding Light=#001D39, Dark=#0A0F14}"/>

        <ScrollView>
            <VerticalStackLayout Spacing="0" Padding="0,0,0,40">

                <!-- Header Info -->
                <Grid ColumnDefinitions="*,Auto" Padding="25,50,25,20">
                    <VerticalStackLayout>
                        <Label Text="Hola," FontSize="16" TextColor="{AppThemeBinding Light=#7BBDE8, Dark=#7BBDE8}"/>
                        <Label x:Name="NombreUsuarioLabel" Text="Usuario" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF"/>
                    </VerticalStackLayout>
                    
                    <Border Grid.Column="1" WidthRequest="46" HeightRequest="46" BackgroundColor="{AppThemeBinding Light=#1A3A5C, Dark=#162231}" StrokeThickness="0" VerticalOptions="Center">
                        <Border.StrokeShape><RoundRectangle CornerRadius="23"/></Border.StrokeShape>
                        <Image Source="ic_bell_white.svg" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                        <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNotificationsClicked"/></Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Active Project Card (Floating) -->
                <Border x:Name="ActiveProjectCard" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#162231}" StrokeThickness="0" Padding="24" Margin="20,10,20,25">
                    <Border.StrokeShape><RoundRectangle CornerRadius="24"/></Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.15" Offset="0,8" Radius="15"/>
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="PROYECTO ACTIVO" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" VerticalOptions="Center"/>
                            <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1A3A5C}" StrokeThickness="0" Padding="12,6">
                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                <Label x:Name="LblEstadoProyectoActivo" Text="Ninguno" FontSize="11" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                        
                        <Label x:Name="LblNombreProyectoActivo" Text="Selecciona un proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="0,5,0,0"/>
                        <Label x:Name="LblUbicacionProyectoActivo" Text="--" FontSize="14" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" Margin="0,0,0,15"/>
                        
                        <Button Text="Ver Detalles" BackgroundColor="{AppThemeBinding Light=#0A4174, Dark=#0A4174}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#FFFFFF}" HeightRequest="48" CornerRadius="24" FontSize="14" FontAttributes="Bold" Clicked="OnActiveProjectDetailsClicked"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Quick Actions (Circular Icons) -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="15" Margin="25,5,25,30">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#162231}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="32"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#000000" Opacity="0.08" Offset="0,4" Radius="10"/></Border.Shadow>
                            <Image Source="{AppThemeBinding Light=ic_plus.svg, Dark=ic_plus_white.svg}" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenNewProjectSheetClicked"/></Border.GestureRecognizers>
                        </Border>
                        <Label Text="Crear" FontSize="13" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="Center">
                        <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#162231}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="32"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#000000" Opacity="0.08" Offset="0,4" Radius="10"/></Border.Shadow>
                            <Image Source="{AppThemeBinding Light=ic_join.svg, Dark=ic_join_white.svg}" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenJoinCodeSheetClicked"/></Border.GestureRecognizers>
                        </Border>
                        <Label Text="Unirse" FontSize="13" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <VerticalStackLayout Grid.Column="2" Spacing="10" HorizontalOptions="Center">
                        <Border WidthRequest="64" HeightRequest="64" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#162231}" StrokeThickness="0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="32"/></Border.StrokeShape>
                            <Border.Shadow><Shadow Brush="#000000" Opacity="0.08" Offset="0,4" Radius="10"/></Border.Shadow>
                            <Image Source="{AppThemeBinding Light=ic_ruler.svg, Dark=ic_ruler_white.svg}" WidthRequest="28" HeightRequest="28" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnReglaARClicked"/></Border.GestureRecognizers>
                        </Border>
                        <Label Text="Regla AR" FontSize="13" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="ProjectsSection" Spacing="15" Padding="20,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mis Proyectos" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" VerticalOptions="Center"/>
                        <Border Grid.Column="1" x:Name="RefreshBorder" BackgroundColor="Transparent" StrokeThickness="0" WidthRequest="32" HeightRequest="32">
                            <Image Source="{AppThemeBinding Light=ic_refresh.svg, Dark=ic_refresh_white.svg}" WidthRequest="20" HeightRequest="20" HorizontalOptions="Center" VerticalOptions="Center"/>
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnRefreshClicked"/></Border.GestureRecognizers>
                        </Border>
                    </Grid>
                    
                    <ActivityIndicator x:Name="LoadingProjectsIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HorizontalOptions="Center" Margin="0,20"/>
                    
                    <CollectionView x:Name="ProjectsCollectionView">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="15"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#162231}" StrokeThickness="0" WidthRequest="260">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
                                    <Border.Shadow><Shadow Brush="#000000" Opacity="0.1" Offset="0,4" Radius="10"/></Border.Shadow>
                                    <Grid RowDefinitions="*,Auto" Padding="20">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="{Binding Nombre}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" MaxLines="1" LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding Ubicacion}" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                                            <Border BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1A3A5C}" StrokeThickness="0" HorizontalOptions="Start" Padding="10,5" Margin="0,8,0,0">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                                                <Label Text="{Binding Estado}" FontSize="11" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" FontAttributes="Bold"/>
                                            </Border>
                                        </VerticalStackLayout>
                                        <Button Grid.Row="1" Text="Seleccionar" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#0A4174}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HeightRequest="42" CornerRadius="21" FontSize="13" FontAttributes="Bold" Margin="0,20,0,0" CommandParameter="{Binding .}" Clicked="OnSelectProjectClicked"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10" Padding="20">
                                <Label Text="Aún no tienes proyectos" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                                <Label Text="Toca 'Crear' o 'Unirse'" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="13" HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>
                        </CollectionView.EmptyView>
                    </CollectionView>
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="NotificationsSection" Spacing="15" Padding="20,25,20,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Avisos Recientes" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" VerticalOptions="Center"/>
                        <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#162231}" StrokeThickness="0" Padding="12,6">
                            <Border.StrokeShape><RoundRectangle CornerRadius="14"/></Border.StrokeShape>
                            <Label x:Name="NotificationCountBadge" Text="0 nuevas" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" VerticalOptions="Center"/>
                        </Border>
                    </Grid>
                    <VerticalStackLayout x:Name="NotificationsContainer" Spacing="12">
                    </VerticalStackLayout>
                </VerticalStackLayout>
                
            </VerticalStackLayout>
        </ScrollView>

        <BoxView x:Name="DetailsBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseDetailsSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="ProjectDetailsSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="DetailsSheetCard" Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="{AppThemeBinding Light=#BDD8E9, Dark=#444444}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label x:Name="SheetProjectName" Text="Nombre Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                        <Label x:Name="SheetProjectCode" Text="Código: --" FontSize="12" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                    </VerticalStackLayout>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseDetailsSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" Padding="15">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="SheetProjectDesc" Text="Sin descripción" FontSize="14" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                        <Label x:Name="SheetProjectUbicacion" Text="Ubicación: --" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                        <Label x:Name="SheetProjectEstado" Text="Estado: --" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontAttributes="Bold"/>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Activar" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="48" CornerRadius="24" FontAttributes="Bold" Clicked="OnSetAsActiveProjectClicked"/>
                    <Button Grid.Column="1" Text="Diseño 3D" BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" HeightRequest="48" CornerRadius="24" FontAttributes="Bold" Clicked="OnEnterDesignClicked"/>
                </Grid>
                
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Ver Mediciones" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1A3A5C}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" HeightRequest="44" CornerRadius="22" FontAttributes="Bold" Clicked="OnVerMedicionesClicked"/>
                    <Button Grid.Column="1" Text="Invitar Cliente" BackgroundColor="{AppThemeBinding Light=#E8F1F8, Dark=#1A3A5C}" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" HeightRequest="44" CornerRadius="22" FontAttributes="Bold" Clicked="OnGenerarInvitacionClicked"/>
                </Grid>

                <Button x:Name="BtnSheetEditarProyecto" Text="Editar Proyecto" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" HeightRequest="48" FontAttributes="Bold" Clicked="OnEditarProyectoFromDetailsClicked"/>
                <Button x:Name="BtnSheetEliminarProyecto" Text="Eliminar Proyecto" BackgroundColor="Transparent" TextColor="#D32F2F" HeightRequest="48" FontAttributes="Bold" Clicked="OnEliminarProyectoFromDetailsClicked"/>
            </VerticalStackLayout>
        </Border>

        <BoxView x:Name="NewProjectBackdrop" BackgroundColor="#99000000" Opacity="0" InputTransparent="True">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="NewProjectSheetCard" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" TranslationY="600">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="{AppThemeBinding Light=#BDD8E9, Dark=#444444}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Nuevo Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseNewProjectSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryNombreProyecto" Placeholder="Nombre del proyecto" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EntryUbicacionProyecto" Placeholder="Ubicación / Ciudad" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Crear Proyecto" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitCrearProyectoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <BoxView x:Name="EditProjectBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditProjectSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="EditProjectSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout x:Name="EditProjectSheetCard" Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="{AppThemeBinding Light=#BDD8E9, Dark=#444444}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Editar Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseEditProjectSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditNombreProyecto" Placeholder="Nombre" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditDescripcionProyecto" Placeholder="Descripción" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditUbicacionProyecto" Placeholder="Ubicación" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="EditPresupuestoProyecto" Placeholder="Presupuesto" Keyboard="Numeric" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Guardar Cambios" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitEditarProyectoClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <BoxView x:Name="JoinCodeBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseJoinCodeSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="JoinCodeSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" IsVisible="False" TranslationY="600">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="{AppThemeBinding Light=#BDD8E9, Dark=#444444}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Unirse a Proyecto" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseJoinCodeSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                <Label Text="Ingresa el código proporcionado por tu arquitecto:" FontSize="14" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" HeightRequest="50">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                    <Entry x:Name="JoinCodeEntry" Placeholder="Ej. ARQ-1234" PlaceholderColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" Margin="15,0" VerticalOptions="Center"/>
                </Border>
                <Button Text="Vincular Proyecto" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" HeightRequest="50" CornerRadius="25" FontSize="16" FontAttributes="Bold" Clicked="OnSubmitJoinCodeClicked" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Measurements Sheet -->
        <BoxView x:Name="MeasurementsBackdrop" BackgroundColor="#99000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMeasurementsSheetClicked"/></BoxView.GestureRecognizers>
        </BoxView>
        <Border x:Name="MeasurementsSheetModal" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}" StrokeThickness="0" VerticalOptions="End" IsVisible="False" TranslationY="600">
            <Border.StrokeShape><RoundRectangle CornerRadius="24,24,0,0"/></Border.StrokeShape>
            <VerticalStackLayout Spacing="15" Padding="24,20,24,40">
                <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="2.5" Color="{AppThemeBinding Light=#BDD8E9, Dark=#444444}" HorizontalOptions="Center" Margin="0,0,0,10"/>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Mediciones AR" FontSize="22" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                    <Image Grid.Column="1" Source="ic_close.svg" WidthRequest="24" HeightRequest="24" VerticalOptions="Center">
                        <Image.GestureRecognizers><TapGestureRecognizer Tapped="OnCloseMeasurementsSheetClicked"/></Image.GestureRecognizers>
                    </Image>
                </Grid>
                
                <ActivityIndicator x:Name="LoadingMeasurementsIndicator" IsRunning="False" IsVisible="False" Color="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" HorizontalOptions="Center" Margin="0,10"/>
                
                <CollectionView x:Name="MeasurementsCollectionView" HeightRequest="250">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{AppThemeBinding Light=#F4F6F8, Dark=#000000}" StrokeThickness="0" Margin="0,0,0,10" Padding="15">
                                <Border.StrokeShape><RoundRectangle CornerRadius="12"/></Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Tipo}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}"/>
                                        <Label Text="{Binding Unidad}" FontSize="13" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Valor, StringFormat='{0:F2}'}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#0A4174, Dark=#7BBDE8}" VerticalOptions="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="5" Padding="20">
                            <Label Text="No hay mediciones" TextColor="{AppThemeBinding Light=#0A4174, Dark=#BDD8E9}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Usa la Regla AR para guardar medidas" TextColor="{AppThemeBinding Light=#6EA2B3, Dark=#7BBDE8}" FontSize="12" HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <Border x:Name="AppleToast" BackgroundColor="{AppThemeBinding Light=#001D39, Dark=#FFFFFF}" StrokeThickness="0" HorizontalOptions="Center" VerticalOptions="Start" Margin="0,40,0,0" Padding="20,12" Opacity="0" IsVisible="False">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Label x:Name="AppleToastMessage" TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#001D39}" FontSize="14" FontAttributes="Bold"/>
        </Border>
    </Grid>
</ContentPage>
